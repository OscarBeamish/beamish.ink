{
  "name": "beamish",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter @beamish/site dev",
    "build": "pnpm generate && pnpm --filter @beamish/site build",
    "preview": "pnpm --filter @beamish/site preview",
    "generate": "tsx tools/generate/index.ts",
    "generate:check": "tsx tools/generate/index.ts --check",
    "record": "tsx tools/recorder/index.ts",
    "build:items": "tsx tools/build-items.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "review": "tsx tools/review/index.ts",
    "check": "pnpm typecheck && pnpm generate:check && pnpm test && pnpm build && pnpm review",
    "social": "tsx tools/social/index.ts",
    "verify:pin": "tsx tools/verify-pin/index.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.172.0",
    "esbuild": "^0.24.2",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "three": "^0.172.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "vue": "^3.5.13",
    "zod": "^3.24.1"
  }
}
