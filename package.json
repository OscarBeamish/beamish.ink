{
  "name": "beamish",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter @beamish/site dev",
    "build": "pnpm generate && pnpm --filter @beamish/site build",
    "preview": "pnpm --filter @beamish/site preview",
    "generate": "tsx tools/generate/index.ts",
    "generate:check": "tsx tools/generate/index.ts --check",
    "record": "tsx tools/recorder/index.ts",
    "build:items": "tsx tools/build-items.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "react": "^19.0.0",
    "three": "^0.172.0",
    "@types/three": "^0.172.0",
    "vue": "^3.5.13",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zod": "^3.24.1",
    "esbuild": "^0.24.2"
  }
}
