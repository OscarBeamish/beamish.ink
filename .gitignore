node_modules/
dist/
.astro/
.DS_Store
*.log
.env
.env.*
!.env.template

# recorder scratch — frames are intermediate, media/ is committed
tools/recorder/.frames/

# compiled demo bundles (built by `pnpm build:items`, regenerated on demand)
effects/*/demo.bundle.js
components/*/demo.bundle.js
components/*/demo.bundle.css
site/public/media/
site/public/fonts/
# Copies sync-public.mjs recreates: the grid demos served whole, and the
# shared stylesheets that go with them.
site/public/grid-demos/
site/public/shared/
site/public/template-demos/
site/public/grids/
site/public/components/
site/.astro/
tools/review/.shots/
# Built by the stage test from shared/stage.ts and three cores.
tools/tests/fixtures/*.bundle.js

# Scratch from measurement runs. See AGENTS.md on measuring.
.shots/
.tmp/
.paste/
.*.mjs
.*.py

# Scratch from a long unattended run: the batch work directory and any
# tools/.tmp-* script written to drive it. Both are run artefacts, and both
# got committed by a careless `git add -A` before this existed.
tools/.dark-run/
tools/.tmp-*
