node_modules/
dist/
.astro/
.DS_Store
*.log
.env
.env.*
!.env.template

# recorder scratch — frames are intermediate, media/ is committed
tools/recorder/.frames/

# compiled demo bundles (built by `pnpm build:items`, regenerated on demand)
effects/*/demo.bundle.js
components/*/demo.bundle.js
components/*/demo.bundle.css
site/public/media/
site/public/fonts/
# Copies sync-public.mjs recreates: the grid demos served whole, and the
# shared stylesheets that go with them.
site/public/grid-demos/
site/public/shared/
site/public/template-demos/
site/public/grids/
site/public/components/
site/.astro/
tools/review/.shots/
# Built by the stage test from shared/stage.ts and three cores.
tools/tests/fixtures/*.bundle.js

# Scratch from measurement runs. See AGENTS.md on measuring.
.shots/
.tmp/
.paste/
.*.mjs
.*.py

# Scratch from a long unattended run: the batch work directory and any
# tools/.tmp-* script written to drive it. Both are run artefacts, and both
# got committed by a careless `git add -A` before this existed.
tools/.dark-run/
tools/.tmp-*

# Reference material. Screenshots of other people's sites, kept locally for
# comparison while something was being built, and no business travelling with
# a library that people clone. Fifteen megabytes of React Bits was in here.
reference/

# Scratch at the root. `.*.mjs` and `.*.py` were already ignored; these two
# escaped because they were committed before the rule existed, and the rule
# did not cover images at all.
.*.jpg
.*.png

# Playable Worlds, mirrored for the hidden showcase page. Someone else's work,
# 700MB of it, and not ours to commit: 283MB of models and 278MB of textures
# against a repo whose own video budget is three and a half. Rebuild it with
# tools/playable-worlds/mirror.py.
site/public/playable-worlds/
