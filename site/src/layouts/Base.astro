---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

type Props = {
  title: string
  description: string
  /** Absolute path to an og image, if the page has one. */
  image?: string | null
  video?: string | null
}

// Item pages pass their own poster. Everything else falls back to the social
// card, because a shared link with no image is a grey box.
const FALLBACK_IMAGE = '/social/preview.png'

const { title, description, image = FALLBACK_IMAGE, video = null } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://beamish.ink')
---

<!doctype html>
<!--
  Paper is the default because that is what the catalogue is mostly made of,
  not because it is the house style: forty-eight of the fifty-eight recorded
  posters are light, and a dark default frames a wall of bright rectangles.
  The library has no house ground and the site is only one page using it.
-->
<html lang="en-GB" data-ground="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Before the first paint, not after. A ground applied on DOMContentLoaded
      shows the default first and then corrects itself, and a page that
      flashes white at somebody who chose dark has told them their choice is
      an afterthought.
    -->
    <script is:inline>
      var applyGround = function (root) {
        try {
          var chosen = localStorage.getItem('beamish-ground')
          if (chosen === 'dark' || chosen === 'paper') {
            root.dataset.ground = chosen
          }
        } catch (error) {
          /* Private windows throw on localStorage. The default stands. */
        }
      }
      applyGround(document.documentElement)

      /*
       * And again on every swap, onto the document that is arriving.
       *
       * The router copies the incoming <html> element's attributes over the
       * live one, and every page is built carrying the static default. Without
       * this, somebody who chose dark gets paper the moment they click
       * anything, which is the same failure the inline script above exists to
       * prevent on first load, one navigation later.
       */
      document.addEventListener('astro:before-swap', function (event) {
        applyGround(event.newDocument.documentElement)
      })

      /*
       * The two faces again, this time as objects the document owns.
       *
       * The pair declared in /fonts.css are CSS-connected: they belong to that
       * stylesheet, and the router's swap disconnects and reconnects it, which
       * throws them away and makes new unloaded ones. These do not belong to a
       * stylesheet, so nothing the router does to the head touches them, and a
       * loaded face in document.fonts is enough for the text to be painted in
       * it whatever happened to the CSS copy.
       *
       * Loaded rather than merely added, because adding an unloaded face is
       * the same race in a different place. They come from cache after the
       * first page, so this costs nothing on any navigation.
       */
      try {
        var faces = [
          ['Archivo', '/fonts/archivo-latin.woff2'],
          ['JetBrains Mono', '/fonts/jetbrains-mono-latin.woff2']
        ]
        faces.forEach(function (entry) {
          var face = new FontFace(entry[0], "url('" + entry[1] + "') format('woff2')", {
            weight: '400 700',
            style: 'normal',
            display: 'swap'
          })
          face.load().then(function (loaded) {
            document.fonts.add(loaded)
          }, function () {
            /* The CSS copy is still there; this is belt and braces. */
          })
        })
      } catch (error) {
        /* No FontFace constructor is no worse than before it existed. */
      }
    </script>
    <link rel="canonical" href={canonical.href} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(image ?? FALLBACK_IMAGE, canonical).href} />
    <meta property="og:image:alt" content={description} />
    {/* The videos are the product, so a shared link should unfurl into one. */}
    {video && <meta property="og:video" content={new URL(video, canonical).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    {/*
      Both faces, not one.
 
      Only the mono was preloaded, and the headings are set in the display face.
      Both are declared font-display: swap, so an unpreloaded face means the
      title is painted in the fallback and then reflows to the real one at full
      size. The mono got a head start and the thing people look at did not.

      A preload is the only way the browser learns about a font before it has
      parsed the CSS and worked out that something on the page needs it.
      crossorigin is not optional here: fonts are fetched anonymously, and a
      preload without it is a second, separate request rather than a head start.
    */}
    {/*
      transition:persist on a preload, which looks odd and is the point.

      The router keeps a stylesheet that exists on the next page and replaces
      everything else in the head. A preload link is not a stylesheet, so both
      of these were being torn out and put back on every single navigation, and
      a re-inserted preload is a new fetch for a file the browser already has.

      Verified on the built site with `NAVCHECK_REQUESTS=on pnpm navcheck`:
      two font files fetched in total across a four-page walk, none of them
      after the first page.

      Persisting them says these two elements are the same two elements on
      every page, which they are: they are in the layout, not in a page.
    */}
    {/*
      The faces are declared in a static stylesheet rather than in global.css,
      so there is one href that is the same string in dev and in a build. That
      is necessary and, on its own, it is not sufficient.

      A CSS-connected FontFace belongs to the stylesheet that declared it. The
      router keeps this link element, and the same node still ends up
      disconnected and reconnected across a swap, which destroys those faces
      and builds new ones in the unloaded state. Measured: the link is the same
      node afterwards and both FontFace objects are new. transition:persist on
      it changes nothing, because persist is for elements in the body.

      They reload from cache almost at once, which is why this looked fixed:
      under any slack at all they are ready by the time the page is shown. Put
      the machine under load and they are not, and font-display: swap paints
      the fallback under every heading on the site.

      So the faces are also added through the FontFace API below, which makes a
      copy that is not CSS-connected and therefore belongs to the document
      rather than to a stylesheet. Those survive every swap, loaded.
    */}
    <link rel="stylesheet" href="/fonts.css" />

    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      transition:persist
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      transition:persist
    />

    {/*
      Client-side navigation: the next page is fetched and swapped in rather
      than the browser throwing the document away and starting again.

      Three things in this site assume a full load and had to be told
      otherwise. The demo panels release their WebGL contexts on `pagehide`,
      which never fires now, so they release on `astro:before-swap` instead and
      the one-context budget still holds. The scripts below run once per real
      load and not again on a swap, so anything that has to happen per page
      hangs off `astro:page-load`. And `data-ground` lives on <html>, which the
      incoming document carries at its static default, so it is put back from
      the stored choice before the swap lands rather than flashing paper at
      somebody who chose dark.

      Reduced motion is handled by the router itself: it swaps without the
      cross-fade when the preference is set.
    */}
    <ClientRouter />
  </head>

  <body class="min-h-dvh">
    <!--
      Fixed and full bleed, with the links given half the bar and spread across
      it. A short nav pushed into the right corner reads as an afterthought;
      given room and told to justify between, it reads as part of the grid.

      Hover is a dotted rule drawn on a ::before over the whole control rather
      than an underline or a colour change. It costs no layout, it works the same
      over any background, and it is the one treatment that survives the blend
      below.

      mix-blend-mode: difference against white asks nothing of the page and needs
      telling nothing: whatever pixel is behind, the type comes out its inverse.
      That matters because the nav sits over demo panels that can be any colour a
      shader decides to produce.

      The blend has to be on the fixed element itself. `position: fixed` creates a
      stacking context and blending is isolated to one, so the same rule on a
      child has nothing to blend against and renders plain white.
    -->
    <header class="site-nav">
      <div class="site-nav__row">
        <a href="/" class="site-nav__mark site-nav__hit">
          <!--
            Inline SVG rather than an img, so it takes currentColor. The nav
            blends against whatever is behind it, and an img would stay one
            colour while the type beside it inverted.

            The viewBox starts at -4.5 because the artwork occupies x 0 to 65 of
            a 74 unit box, so the shape's centre sits left of the element's. The
            window is shifted to centre it; nothing about the path changes.
          -->
          <svg
            class="site-nav__icon"
            viewBox="-4.5 0 74 74"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M8.51875 16.8366L30.8985 3.7998V15.0728L8.51875 16.8366ZM34.1 15.0728V3.79864L56.4803 16.836L34.1 15.0728ZM61.7975 26.2919V52.2433L52.2975 46.871L61.7975 26.2919ZM47.149 49.1689L32.4998 70.1906L17.8507 49.1689H47.149ZM12.6912 46.8768L3.20154 52.2433V26.2995L12.6912 46.8768ZM35.4053 18.4157L60.9734 20.4295L50.078 44.057L35.4053 18.4157ZM17.5404 45.9388L32.4992 19.7964L47.4592 45.9388H17.5404ZM14.9211 44.0564L4.0257 20.4301L29.5932 18.4157L14.9211 44.0564ZM4.83782 55.0204L14.3005 49.6689L27.0249 67.9443L4.83782 55.0204ZM37.9811 67.9402L50.7094 49.6752L60.1618 55.0204L37.9811 67.9402ZM62.246 16.4656L35.2533 0.742132C33.554 -0.247386 31.4451 -0.247386 29.7469 0.742132L2.75361 16.4656C1.05481 17.4546 -0.000488281 19.2982 -0.000488281 21.2772V52.7236C-0.000488281 54.7021 1.05481 56.5463 2.75361 57.5352L29.7457 73.2581C30.5951 73.7529 31.5472 74 32.4992 74C33.4513 74 34.4034 73.7529 35.2522 73.2581L62.2455 57.5352C63.9443 56.5463 64.9995 54.7021 64.9995 52.7236V21.2772C64.9995 19.2988 63.9442 17.4551 62.246 16.4656Z" />
          </svg>
          <span data-scramble>Beamish.ink</span>
        </a>
        <nav class="site-nav__links" aria-label="Primary">
          <a href="/effects" class="site-nav__hit" data-scramble>Effects</a>
          <a href="/grids" class="site-nav__hit" data-scramble>Grids</a>
          <a href="/templates" class="site-nav__hit" data-scramble>Templates</a>
          <a href="/how-it-works" class="site-nav__hit" data-scramble>How it works</a>
          <a
            href="https://github.com/OscarBeamish/beamish.ink"
            class="site-nav__hit"
            data-scramble
            rel="noreferrer"
            target="_blank">GitHub</a
          >
          <!--
            The ground, as a control rather than a preference buried in the
            system. This library endorses two grounds and says so per item, so
            the catalogue that displays them has to be able to show either.
          -->
          <button type="button" class="site-nav__hit site-nav__ground" data-ground-toggle>
            <!-- Matches data-ground on <html> above, so it is already right
                 before the script runs and never corrects itself in view. -->
            <span data-ground-label>THEME[L]</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-line mt-24 border-t px-5 py-10 md:px-8">
      <p class="text-l3 max-w-[52ch] text-[0.8rem]">
        Open source web effects and interface components, delivered as prompts for
        AI coding agents. No package, no CLI. Every prompt pins its source URLs to
        a git tag, so what you paste today still works next year.
      </p>
      <p class="text-l3 mt-6 text-[0.7rem] tracking-[0.1em] uppercase">
        MIT · <a class="dotted-hit" href="https://github.com/OscarBeamish/beamish.ink">GitHub</a> ·
        <a class="dotted-hit" href="https://oscarbeamish.dev">Oscar Beamish</a>
      </p>
    </footer>

    <script>
      /*
       * Lenis drives scroll everywhere on the site. Reduced motion gets the
       * native scroll instead: a smoothed scroll is still motion the user did
       * not ask for.
       *
       * `lerp`, not `duration`. They are two different modes. A duration runs a
       * fixed easing curve to the target, so every flick takes the same time
       * however far it is going, and a short nudge feels syrupy. A lerp closes
       * a fraction of the remaining distance per frame, so it is quick to leave
       * and slow to arrive and the length of the gesture sets the length of the
       * movement. 0.1 is the reference's value and it is the right one.
       *
       * `anchors` because an item page links back to its shelf at
       * /effects#<category>, and without it that one link jumps while every
       * other movement on the site glides.
       */
      const reduced = matchMedia('(prefers-reduced-motion: reduce)')
      if (!reduced.matches) {
        const { default: Lenis } = await import('lenis')
        const lenis = new Lenis({
          lerp: 0.1,
          smoothWheel: true,
          syncTouch: true,
          anchors: true,
          // The site owns the frame loop below rather than letting Lenis start
          // a second one of its own.
          autoRaf: false
        })
        const raf = (time: number) => {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }
        requestAnimationFrame(raf)

        /*
         * Lenis is created once and kept. It binds to the window rather than
         * to anything in the document, so it survives a swap and must not be
         * built again: a second instance would drive the same scroll from its
         * own frame loop and the page would fight itself.
         *
         * What it does need is telling that the page changed. The router
         * restores scroll position itself, and Lenis holds its own idea of
         * where it is, so without this a navigation lands at the top of the
         * document with Lenis still easing towards wherever you were on the
         * last one.
         */
        document.addEventListener('astro:after-swap', () => {
          lenis.scrollTo(0, { immediate: true })
        })
      }
    </script>

    <script>
      /*
       * Scramble-on-hover for the nav, which is DecodeText from the library
       * rather than a copy of it kept here. The site had its own for a while, with a
       * comment on it saying the effect was chrome rather than an item. It is
       * an item now, so this is the item.
       *
       * Mounted on first hover rather than at load. Mounting draws a frame as
       * soon as the element is measured, and frame zero of a one-shot reveal is
       * the unresolved one, which would leave the whole bar in cipher until
       * somebody pointed at it.
       *
       * The run always finishes, even if the pointer leaves: a label abandoned
       * half decoded is unreadable at the exact moment somebody is reading it.
       * Re-entering while it is still going does nothing, so sweeping the
       * cursor along the bar does not stack three runs on one label.
       */
      import { createDecodeText } from '@items/effects/decode-text/core'

      const STAGGER = 45
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')

  /*
   * Bound on every page rather than once at load, because the router replaces
   * the header along with everything else and the new labels have no listener
   * on them. The dataset flag is what stops a label that survived a swap from
   * being bound twice and running two decodes over each other.
   */
  const bindScramble = () => {
      for (const el of document.querySelectorAll<HTMLElement>('[data-scramble]')) {
        if (el.dataset['scrambleBound'] === '') continue
        el.dataset['scrambleBound'] = ''
        const characters = (el.textContent ?? '').trim().length
        let decode: ReturnType<typeof createDecodeText> | null = null
        let running = false

        /*
         * The label decodes; something else may be what you point at. A card's
         * title sits in a strip at the bottom of a poster, and a reader hovers
         * the card, not the eleven characters of its name. The host is the
         * element that listens, and for a nav link it is the link itself.
         */
        const host = el.closest<HTMLElement>('[data-scramble-host]') ?? el

        const run = () => {
          // Read live rather than at load, so changing the setting with the page
          // open takes effect without a reload.
          if (running || reduced.matches) return
          running = true

          if (!decode) decode = createDecodeText(el, { stagger: STAGGER, hold: 0, dim: 0.5 })
          decode.renderAtTime(0)
          decode.start()

          window.setTimeout(() => {
            decode?.stop()
            running = false
          }, STAGGER * characters + 250)
        }

        host.addEventListener('pointerenter', run)
        /*
         * And on focus, or every one of these is a still label to anybody
         * navigating by keyboard. focusin rather than focus because the host
         * can be the card and the thing that takes focus is the card's link.
         */
        host.addEventListener('focusin', run)
      }
  }

  document.addEventListener('astro:page-load', bindScramble)
    </script>

    <script>
      /*
       * The ground toggle.
       *
       * THEME[L] and THEME[D], after haoqi.design, whose ASCII toggle this
       * nav's scramble and label tokens already come from. The bracketed
       * letter is a readout and a control at once, which is the one thing a
       * word cannot be: "Dark" has to mean either where you are or where the
       * button goes, and whichever you pick half the people read it the other
       * way. A letter in brackets reads as a position on a switch.
       *
       * It also retires the word paper from the interface. The ground is still
       * called paper in meta.json, in the tokens and in all seventy-odd demo
       * pages, because that is a value with a meaning, not a button.
       *
       * The attribute is already correct before this runs, set by the inline
       * script in the head, so nothing here has to fix a flash.
       */
      const root = document.documentElement

      /*
       * Found and bound per page. The button in the header of the document
       * that arrives is a different element from the one that left, so the
       * listener does not come with it, and the label has to be set again to
       * match whatever ground is actually in force.
       */
      const bindToggle = () => {
      const toggle = document.querySelector<HTMLButtonElement>('[data-ground-toggle]')
      const label = toggle?.querySelector<HTMLElement>('[data-ground-label]')

      const show = (ground: string) => {
        if (label) label.textContent = ground === 'dark' ? 'THEME[D]' : 'THEME[L]'
        toggle?.setAttribute(
          'aria-label',
          ground === 'dark' ? 'Theme: dark. Switch to light' : 'Theme: light. Switch to dark'
        )
      }

      show(root.dataset.ground ?? 'paper')

      if (toggle?.dataset['groundBound'] === '') return
      if (toggle) toggle.dataset['groundBound'] = ''

      toggle?.addEventListener('click', () => {
        const next = root.dataset.ground === 'dark' ? 'paper' : 'dark'
        root.dataset.ground = next
        show(next)
        try {
          localStorage.setItem('beamish-ground', next)
        } catch (error) {
          /* Nothing to do: the choice holds for this page either way. */
        }
        /*
         * Anything already mounted resolved `auto` against the old ground, so
         * it is painting the colour of a page that no longer exists. Items
         * re-read the page on update, and the ones that take no colour ignore
         * this harmlessly.
         */
        document.dispatchEvent(new CustomEvent('beamish:ground', { detail: next }))
      })
      }

      document.addEventListener('astro:page-load', bindToggle)

      /*
       * A diagnostic that reads itself out on the page, at /?probe=1.
       *
       * It lives here rather than in a component of its own because Astro
       * hoists script tags at compile time and will not run one nested in a
       * conditional expression, which is how the first attempt failed
       * silently. It exists at all because asking somebody to paste a snippet
       * into DevTools failed three times running, and not through any fault
       * of theirs: the console takes the previous output along with the
       * paste, so a one-liner copied out of a chat window arrives with a
       * renderer string on line three and reports a syntax error where the
       * measurement should have been. Worse, two separate pastes are two
       * separate moments, and comparing a buffer size from one against a box
       * size from the other produced a confident diagnosis of a mismatch that
       * did not exist. One run, one snapshot, no copying.
       *
       * import.meta.env.DEV is a compile-time constant, so this whole block
       * is eliminated from a build.
       */
      if (import.meta.env.DEV) {
        const probe = async () => {
          if (!new URLSearchParams(location.search).has('probe')) return
          const canvas =
            document.querySelector('[data-stage] canvas') || document.querySelector('canvas')

          const panel = document.createElement('div')
          panel.id = 'beamish-probe'
          panel.style.cssText =
            'position:fixed;right:12px;bottom:12px;z-index:2147483647;max-width:min(92vw,470px);' +
            'padding:10px 12px;border-radius:6px;background:#101014;color:#e8e8e4;' +
            'font:12px/1.45 ui-monospace,monospace;white-space:pre-wrap;word-break:break-all;' +
            'box-shadow:0 10px 40px rgba(0,0,0,.5)'
          panel.textContent = 'Beamish probe: measuring…'
          document.body.appendChild(panel)
          if (!canvas) { panel.textContent = 'Beamish probe: no canvas on this page'; return }

          const gl = canvas.getContext('webgl2') || canvas.getContext('webgl')
          const proto = Object.getPrototypeOf(gl)
          const realU = proto.uniform1f
          const realD = proto.drawArrays
          const locs = new Map()
          const times = [], gaps = [], px = [], geom = []
          let draws = 0, frames = 0, lastT

          proto.uniform1f = function (l, v) {
            if (l) {
              if (!locs.has(l)) locs.set(l, locs.size)
              if (locs.get(l) === 1) lastT = v
            }
            return realU.call(this, l, v)
          }
          proto.drawArrays = function () {
            draws++
            const r = realD.apply(this, arguments)
            if (typeof lastT === 'number') times.push(lastT)
            return r
          }

          let last = performance.now()
          await new Promise(done => {
            const step = () => {
              const now = performance.now()
              gaps.push(now - last)
              last = now
              /* Full precision. Rounding here is what would hide a sub-pixel
                 jitter, which is the one thing reading the buffer cannot see. */
              const r = canvas.getBoundingClientRect()
              const cs = getComputedStyle(canvas)
              geom.push([r.x, r.y, r.width, r.height, cs.transform, cs.opacity].join('|'))
              try {
                const b = new Uint8Array(4)
                gl.readPixels((canvas.width / 2) | 0, (canvas.height / 2) | 0, 1, 1,
                  gl.RGBA, gl.UNSIGNED_BYTE, b)
                px.push(b[0] + ',' + b[1] + ',' + b[2])
              } catch (e) { /* context gone; the counts below will say so */ }
              if (++frames < 150) requestAnimationFrame(step)
              else done(null)
            }
            requestAnimationFrame(step)
          })

          proto.uniform1f = realU
          proto.drawArrays = realD

          const mid = xs => [...xs].sort((a, b) => a - b)[xs.length >> 1]
          const steps = times.slice(1).map((t, i) => t - times[i])
          let alternating = 0
          for (let i = 2; i < px.length; i++) {
            if (px[i] === px[i - 2] && px[i] !== px[i - 1]) alternating++
          }
          const states = [...new Set(geom)]
          let boxChanges = 0
          for (let i = 1; i < geom.length; i++) if (geom[i] !== geom[i - 1]) boxChanges++
          const dbg = gl.getExtension('WEBGL_debug_renderer_info')

          const text = JSON.stringify({
            dpr: devicePixelRatio,
            buffer: canvas.width + 'x' + canvas.height,
            boxStates: states.length,
            boxChanges,
            box: states.slice(0, 3),
            refreshHz: Math.round(1000 / mid(gaps)),
            worstGapMs: Math.round(Math.max.apply(null, gaps)),
            drawsPerFrame: Number((draws / frames).toFixed(2)),
            clockBackwards: steps.filter(d => d <= 0).length,
            clockBiggestStep: Number(Math.max.apply(null, steps.map(Math.abs)).toFixed(4)),
            distinctPixels: new Set(px).size + '/' + px.length,
            alternating,
            renderer: dbg
              ? String(gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)).slice(0, 44)
              : 'masked'
          }, null, 1)
          panel.textContent = text
          console.log('BEAMISH PROBE', text)
        }
        /* After the panel has mounted and the effect has settled. */
        document.addEventListener('astro:page-load', () => setTimeout(probe, 2500))
      }
    </script>
  </body>
</html>
