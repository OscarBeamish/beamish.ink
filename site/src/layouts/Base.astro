---
import '../styles/global.css'

type Props = {
  title: string
  description: string
  /** Absolute path to an og image, if the page has one. */
  image?: string | null
  video?: string | null
}

// Item pages pass their own poster. Everything else falls back to the social
// card, because a shared link with no image is a grey box.
const FALLBACK_IMAGE = '/social/preview.png'

const { title, description, image = FALLBACK_IMAGE, video = null } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://beamish.ink')
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical.href} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(image ?? FALLBACK_IMAGE, canonical).href} />
    <meta property="og:image:alt" content={description} />
    {/* The videos are the product, so a shared link should unfurl into one. */}
    {video && <meta property="og:video" content={new URL(video, canonical).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="min-h-dvh">
    <!--
      Fixed and full bleed, with the links given half the bar and spread across
      it. A three-item nav pushed into the right corner reads as an afterthought;
      given room and told to justify between, it reads as part of the grid.

      Hover is a dotted rule drawn on a ::before over the whole control rather
      than an underline or a colour change. It costs no layout, it works the same
      over any background, and it is the one treatment that survives the blend
      below.

      mix-blend-mode: difference against white asks nothing of the page and needs
      telling nothing: whatever pixel is behind, the type comes out its inverse.
      That matters because the nav sits over demo panels that can be any colour a
      shader decides to produce.

      The blend has to be on the fixed element itself. `position: fixed` creates a
      stacking context and blending is isolated to one, so the same rule on a
      child has nothing to blend against and renders plain white.
    -->
    <header class="site-nav">
      <div class="site-nav__row">
        <a href="/" class="site-nav__mark site-nav__hit" data-scramble>Beamish</a>
        <nav class="site-nav__links" aria-label="Primary">
          <a href="/#catalogue" class="site-nav__hit" data-scramble>Index</a>
          <a href="/how-it-works" class="site-nav__hit" data-scramble>How it works</a>
          <a
            href="https://github.com/OscarBeamish/beamish.ink"
            class="site-nav__hit"
            data-scramble
            rel="noreferrer"
            target="_blank">GitHub</a
          >
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-line mt-24 border-t px-5 py-10 md:px-8">
      <p class="text-l3 max-w-[52ch] text-[0.8rem]">
        Open source web effects and interface components, delivered as prompts for
        AI coding agents. No package, no CLI. Every prompt pins its source URLs to
        a git tag, so what you paste today still works next year.
      </p>
      <p class="text-l3 mt-6 text-[0.7rem] tracking-[0.1em] uppercase">
        MIT · <a href="https://github.com/OscarBeamish/beamish.ink">GitHub</a> ·
        <a href="https://oscarbeamish.dev">Oscar Beamish</a>
      </p>
    </footer>

    <script>
      // Lenis drives scroll everywhere on the site. Reduced motion gets the
      // native scroll instead. A smoothed scroll is still motion the user did not
      // ask for.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)')
      if (!reduced.matches) {
        const { default: Lenis } = await import('lenis')
        const lenis = new Lenis({ duration: 1.05 })
        const raf = (time: number) => {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }
        requestAnimationFrame(raf)
      }
    </script>

    <script>
      /*
       * Scramble-on-hover for the nav.
       *
       * Each label settles one character at a time, left to right, with the
       * characters that have not landed yet cycling through a fixed glyph set.
       * It is the site's own chrome rather than a library item: ScrambleText is
       * a rise-and-blur reveal and stays that way.
       *
       * Two things keep it from being annoying. The animation always runs to
       * completion even if the pointer leaves, because a label abandoned
       * mid-scramble is unreadable and looks broken. And re-entering while it is
       * still going does nothing, so sweeping the cursor along the bar does not
       * stack three copies on the same element.
       */
      const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*+-=?/<>[]{}'
      const SETTLE_MS = 45

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')

      for (const el of document.querySelectorAll<HTMLElement>('[data-scramble]')) {
        const original = el.textContent ?? ''
        const chars = [...original]
        let running = false

        el.addEventListener('pointerenter', () => {
          // Reading it live rather than at load, so changing the setting with the
          // page open takes effect without a reload.
          if (running || reduced.matches) return
          running = true

          /*
           * Pin the width for the duration. The links are monospace and would
           * hold their own, but the wordmark is set in the display face, where
           * swapping W for I mid-animation would shuffle the whole bar.
           */
          const width = el.getBoundingClientRect().width
          el.style.width = `${width}px`

          let settled = 0
          const tick = () => {
            if (settled > chars.length) {
              el.textContent = original
              el.style.width = ''
              running = false
              return
            }
            el.textContent = chars
              .map((c, i) => {
                if (i < settled) return c
                // Spaces stay spaces, so the word shape is legible throughout
                // and the label never reads as one long run of noise.
                if (c === ' ') return ' '
                return GLYPHS[Math.floor(Math.random() * GLYPHS.length)]
              })
              .join('')
            settled += 1
            window.setTimeout(tick, SETTLE_MS)
          }
          tick()
        })
      }
    </script>
  </body>
</html>
