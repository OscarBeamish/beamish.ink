---
/*
 * The product surface. Two buttons, and neither of them may ever be a dead end.
 * The first hands the agent pinned URLs to fetch. The second hands it the same
 * instructions with the source pasted in, for agents with no web access.
 *
 * The pills are SheenButton's own stylesheet, not a copy of it. If the button on this
 * page and the button in the prompt ever diverge, the site is lying.
 */
import '@items/components/sheen-button/styles.css'

type Props = {
  slug: string
  linked: string
  /*
   * Optional, because not everything has one. An item can carry its source in
   * the prompt since an item is one file; a template is four of its own plus a
   * dozen library ones, so there is nothing sane to inline. When it is absent
   * the second button is not rendered at all rather than rendered and inert,
   * which is the rule at the top of this file: neither button may ever be a
   * dead end, and the cheapest way to keep that true is not to draw one.
   */
  inlined?: string | undefined
}

const { slug, linked, inlined } = Astro.props

/*
 * The prompts contain wiring examples, and those examples contain a closing
 * script tag. Inside a script element the parser closes on that sequence
 * wherever it appears, string literal or not, so it has to be escaped. Nothing
 * else about the JSON changes, and JSON.parse reads `<\/` as `</`.
 *
 * This comment is escaped for the same reason, which is not pedantry: written
 * out plainly it ended the frontmatter early and Vite's dependency scanner
 * failed to parse the file. The production build never hit it, and neither did
 * a dev server with a warm cache, so it only appeared on a fresh clone.
 */
const embed = (text: string) => JSON.stringify(text).replaceAll('</', '<\\/')
---

<div class="prompt-buttons flex flex-wrap items-center gap-3" data-slug={slug}>
  <button type="button" class="beamish-sheen-button beamish-sheen-button--solid" data-copy="linked">
    <span data-label>Copy prompt</span>
  </button>
  {
    inlined && (
      <button type="button" class="beamish-sheen-button beamish-sheen-button--quiet" data-copy="inlined">
        <span data-label>Copy with code inlined</span>
      </button>
    )
  }

  {/* Kept out of the DOM as text so a stray selection cannot pick up 8kB of markdown. */}
  <script type="application/json" data-prompt="linked" set:html={embed(linked)} />
  {inlined && <script type="application/json" data-prompt="inlined" set:html={embed(inlined)} />}

  <p class="text-l3 basis-full text-[0.7rem] tracking-[0.08em] uppercase">
    Paste into Claude Code, Cursor or any agent. Pinned to a tag, so it will not
    change under you.
  </p>
</div>

<script>
  const RESET_AFTER = 2200

  /*
   * Bound per page. The client router swaps the document without reloading, so
   * a handler attached at load belongs to buttons that are no longer in the
   * page: Copy prompt is the one control this whole site exists to offer, and
   * it would have gone dead on every navigation after the first.
   *
   * The dataset flag is for a button that survives a swap, which should not
   * end up with the handler on it twice.
   */
  const bind = () => {
  document.querySelectorAll<HTMLElement>('.prompt-buttons').forEach(root => {
    if (root.dataset['promptBound'] === '') return
    root.dataset['promptBound'] = ''
    const read = (kind: string) => {
      const node = root.querySelector<HTMLScriptElement>(`script[data-prompt="${kind}"]`)
      return node ? (JSON.parse(node.textContent ?? '""') as string) : ''
    }

    root.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach(button => {
      const label = button.querySelector<HTMLElement>('[data-label]')
      const original = label?.textContent ?? ''

      button.addEventListener('click', async () => {
        const text = read(button.dataset['copy'] ?? '')
        if (!text || !label) return
        try {
          await navigator.clipboard.writeText(text)
          label.textContent = 'Copied'
        } catch {
          // Clipboard access can be refused outright, in an insecure context or
          // by permission. Saying so beats a button that silently does nothing,
          // which reads as broken.
          label.textContent = 'Blocked. Select and copy'
          const range = document.createRange()
          range.selectNodeContents(button)
          getSelection()?.removeAllRanges()
          getSelection()?.addRange(range)
        }
        setTimeout(() => {
          label.textContent = original
        }, RESET_AFTER)
      })
    })
  })
  }

  document.addEventListener('astro:page-load', bind)
</script>
