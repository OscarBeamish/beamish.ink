---
/*
 * A card on the wall. Poster by default, video while it is on screen, and
 * never a live context. The index page cannot host live demos and stay inside the browser's
 * WebGL budget. See DemoPanel.astro.
 *
 * It takes the five things a card shows rather than a catalogue entry, because
 * grids are a separate catalogue with categories of their own. The alternative
 * was a second copy of this markup, and that copy is exactly how the grids wall
 * ended up with a video that never played and a category in the wrong place:
 * the hover script below only binds what this file renders.
 */
type Shot = { poster: string | null; mp4: string | null; webm: string | null }

type Props = {
  href: string
  name: string
  description: string
  label: string
  /*
   * `dark` is the same take against the other ground, and only items that
   * declare `either` have one. The card follows the page: an item that claims
   * both grounds has to show the one you are looking at, or the claim is
   * decoration. An item built for paper keeps its paper take on a dark page,
   * because that is the truth about the item.
   */
  media: Shot & { dark?: Shot | null }
}

/*
 * `description` is accepted and not rendered. The walls all pass it and the
 * detail pages all use it; dropping it from the props would mean editing four
 * call sites to delete a line each, and putting it back later would mean
 * editing them again.
 */
const { href, name, label, media } = Astro.props
const dark = media.dark ?? null
---

<a
  href={href}
  class="item-card group flex h-full flex-col no-underline"
  data-card
  data-scramble-host
>
  <div class="relative aspect-video overflow-hidden rounded-[2px]">
    {
      media.poster ? (
        <img
          src={media.poster}
          alt=""
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
          data-poster
          data-poster-paper={media.poster}
          data-poster-dark={dark?.poster ?? undefined}
        />
      ) : (
        <div class="text-l3 absolute inset-0 grid place-items-center text-[0.7rem] tracking-[0.1em] uppercase">
          no video yet
        </div>
      )
    }
    {
      /*
       * preload="none": sixty-seven cards each preloading a megabyte would
       * cost more than the page several times over. The observer in the
       * script lifts this to "auto" when the card comes within 600px of the
       * viewport, so a reader pays for the wall they actually scrolled.
       */
      (media.webm || media.mp4) && (
        <video
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500"
          muted
          loop
          playsinline
          preload="none"
          data-video
          data-webm-paper={media.webm ?? undefined}
          data-mp4-paper={media.mp4 ?? undefined}
          data-webm-dark={dark?.webm ?? undefined}
          data-mp4-dark={dark?.mp4 ?? undefined}
        >
          {media.webm && <source src={media.webm} type="video/webm" />}
          {media.mp4 && <source src={media.mp4} type="video/mp4" />}
        </video>
      )
    }
  </div>

  {/*
    A caption under the poster rather than a panel welded to it. The card used
    to be a bordered box with a filled strip along the bottom and a note under
    that, which made a wall of them read as a wall of boxes: what a reader is
    scanning is the pictures, and every border and fill was a line drawn
    between one picture and the next. The name decodes on hover, triggered by
    the card rather than by the name, because two words under a poster are not
    how anybody arrives at a card.
  */}
  <div class="flex items-baseline justify-between gap-3 pt-[0.35rem]">
    <span class="text-l1 text-[0.82rem]" data-scramble>{name}</span>
    <span class="tag">{label}</span>
  </div>
</a>

<script>
  /*
   * The card follows the ground.
   *
   * Only items that declare `either` carry a second take, and only they should
   * switch: an item built for paper is telling the truth by showing a paper
   * video on a dark page, while an `either` item with one paper take is making
   * a claim its evidence does not support. That was the actual bug, not the
   * colour of the page around it.
   *
   * Nothing is preloaded here. The poster swaps immediately because it is
   * already a visible image; the video sources are rewritten but not loaded,
   * so a page nobody hovers still costs one image per card.
   */
  const applyGround = (ground: string) => {
    const dark = ground === 'dark'

    for (const poster of document.querySelectorAll<HTMLImageElement>('[data-poster]')) {
      const wanted = dark
        ? (poster.dataset.posterDark ?? poster.dataset.posterPaper)
        : poster.dataset.posterPaper
      if (wanted && !poster.src.endsWith(wanted)) poster.src = wanted
    }

    for (const video of document.querySelectorAll<HTMLVideoElement>('[data-video]')) {
      const webm = dark
        ? (video.dataset.webmDark ?? video.dataset.webmPaper)
        : video.dataset.webmPaper
      const mp4 = dark
        ? (video.dataset.mp4Dark ?? video.dataset.mp4Paper)
        : video.dataset.mp4Paper

      let changed = false
      for (const source of video.querySelectorAll('source')) {
        const wanted = source.type === 'video/webm' ? webm : mp4
        if (wanted && source.getAttribute('src') !== wanted) {
          source.setAttribute('src', wanted)
          changed = true
        }
      }

      /*
       * load() only when the element has already fetched something. Calling it
       * on an untouched preload="none" video starts the download this card was
       * written to avoid.
       */
      if (changed && video.readyState > 0) {
        const wasPlaying = !video.paused
        video.load()
        if (wasPlaying) void video.play().catch(() => {})
      }
    }
  }

  /*
   * Per page, because the cards on a wall the router has just swapped in have
   * never been touched: their posters are whatever the build wrote, which is
   * the paper take, and a reader on dark would see every card revert.
   *
   * The ground listener stays at the top level. It is on `document`, which
   * survives a swap, and binding it again per page would run applyGround once
   * per navigation for every page ever visited.
   */
  document.addEventListener('astro:page-load', () =>
    applyGround(document.documentElement.dataset.ground ?? 'paper')
  )
  document.addEventListener('beamish:ground', event => {
    applyGround((event as CustomEvent<string>).detail)
  })

  /*
   * A card plays while it is on screen.
   *
   * It used to play on hover, which meant a wall of sixty-seven moving items
   * looked like a wall of sixty-seven stills until you touched one, and on a
   * phone it never moved at all: there is no hover there, and the walls are
   * the main thing this site is.
   *
   * What hover was buying was bandwidth, and an IntersectionObserver buys the
   * same thing more precisely. Nothing is fetched until a card is close to the
   * viewport, and a reader who never scrolls past the first row has still paid
   * for one row. The difference from preload="none" plus hover is that a
   * reader who does scroll pays for what they actually looked at, which is the
   * bargain worth making.
   *
   * Under reduced motion nothing is ever started. WCAG 2.2.2 is Level A and
   * these loop forever, so the poster is the whole experience for that reader,
   * and it is a composed frame rather than a blank.
   */
  const reduced = matchMedia('(prefers-reduced-motion: reduce)')

  /*
   * Two margins, deliberately different, and both measured rather than picked.
   *
   * The loading ring runs a little ahead of the viewport so the swap from
   * poster to video is not a visible pop halfway up the screen. It started at
   * 600px, which pulled 6.6MB of video before the reader had scrolled at all:
   * at 1440 wide that ring is five rows of a three column wall. 200px is two
   * and a bit, and costs 3.4MB on the first screen for the same 17.6MB over
   * the whole sixty-seven. Run `pnpm wallcost /effects` after changing it.
   *
   * The playing ring is the viewport itself, so nothing off screen is being
   * decoded. Four decoders at the bottom of the wall rather than sixty-seven
   * is the difference between this and an autoplay wall that melts a laptop.
   */
  const LOAD_RING = '200px 0px'
  const PLAY_RING = '0px'

  let loader: IntersectionObserver | null = null
  let player: IntersectionObserver | null = null

  /*
   * Which cards are on screen right now.
   *
   * Playing is not a single event, it is a condition that two independent
   * things have to be true for: the card is in view, and the video has data.
   * They arrive in either order. The first version treated it as an event and
   * called play() the moment a card came into view, which on a first screen
   * is before the loader has given the element a source: the promise rejects,
   * the rejection is swallowed, and nothing ever asks again. Measured with
   * `pnpm navplay`, that was nought of three playing on a fresh load and
   * nought of six after clicking to the next wall.
   *
   * So the condition is recorded here and start() is called from both sides:
   * from the observer when the card arrives, and from canplay when the data
   * does. Whichever is second is the one that works.
   */
  const onScreen = new WeakSet<HTMLVideoElement>()
  const watched = new WeakSet<HTMLVideoElement>()

  const start = (video: HTMLVideoElement) => {
    if (reduced.matches || !onScreen.has(video)) return
    void video.play().then(
      () => {
        video.style.opacity = '1'
      },
      () => {
        /* No data yet, or interrupted by a pause on a fast scroll. canplay
           will come back for the first; the second is already correct. */
      }
    )
  }

  const bindCards = () => {
    loader?.disconnect()
    player?.disconnect()

    /*
     * Video waits for the page.
     *
     * Without this the first screen's videos are fetched alongside the
     * posters, the CSS and the fonts, and they are twenty times the size of
     * any of them. The posters are what the reader sees first and the videos
     * are what they see a moment later, so the videos queue behind. An idle
     * callback rather than a timer, because the point is to be out of the way
     * of the page's own work rather than to wait a particular length of time.
     */
    const whenIdle =
      'requestIdleCallback' in window
        ? (run: () => void) => requestIdleCallback(run, { timeout: 2000 })
        : (run: () => void) => setTimeout(run, 400)

    /*
     * preload="none" is in the markup and stays there, so a card that is never
     * approached costs one poster. This is what lifts it, once, per card.
     */
    loader = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          const video = entry.target.querySelector<HTMLVideoElement>('[data-video]')
          if (video && video.preload === 'none') {
            video.preload = 'auto'
            video.load()
          }
          loader?.unobserve(entry.target)
        }
      },
      { rootMargin: LOAD_RING }
    )

    player = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          const video = entry.target.querySelector<HTMLVideoElement>('[data-video]')
          if (!video) continue

          if (entry.isIntersecting) {
            onScreen.add(video)
            start(video)
          } else {
            onScreen.delete(video)
            video.pause()
            /*
             * Paused where it is, not rewound. A card scrolled off and back
             * carries on, which is what a reader moving up and down a wall
             * expects; rewinding made every card restart in step and the wall
             * pulse. The poster stays hidden for the same reason.
             */
          }
        }
      },
      /* A sliver counts as on screen. Threshold zero and a card is playing
         while one pixel of it is under the fold, which is where a reader is
         about to look. */
      { rootMargin: PLAY_RING, threshold: 0 }
    )

    const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')].filter(card =>
      card.querySelector('[data-video]')
    )
    for (const card of cards) {
      player.observe(card)
      /*
       * The other half of the condition, once per element. The listener
       * outlives a rebind, which is why it is guarded: a card that survives
       * a swap must not collect one of these per navigation.
       */
      const video = card.querySelector<HTMLVideoElement>('[data-video]')
      if (video && !watched.has(video)) {
        watched.add(video)
        video.addEventListener('canplay', () => start(video))
      }
    }
    whenIdle(() => {
      for (const card of cards) loader?.observe(card)
    })
  }

  /*
   * Rebound per page rather than kept across one. The observers hold element
   * references, and the cards in a document the router has swapped out are
   * gone: observing the old ones keeps them alive and leaves the new ones
   * still.
   */
  document.addEventListener('astro:page-load', bindCards)

  /*
   * A reader who turns reduced motion on mid-visit gets a still wall, without
   * reloading. The reverse starts everything on screen on the next tick.
   */
  reduced.addEventListener('change', () => {
    if (!reduced.matches) return bindCards()
    for (const video of document.querySelectorAll<HTMLVideoElement>('[data-video]')) {
      video.pause()
      video.style.opacity = '0'
    }
  })
</script>
