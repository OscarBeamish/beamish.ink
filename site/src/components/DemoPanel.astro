---
import '@items/components/sheen-button/styles.css'
import ContentsDemo from '../demos/ContentsDemo'
import SheenButtonDemo from '../demos/SheenButtonDemo'
import PlateDemo from '../demos/PlateDemo'
import CrossbarDemo from '../demos/CrossbarDemo'
/*
 * One live demo, and never more than one on a page.
 *
 * Chromium allows 16 WebGL contexts *or* 16 × 1024 × 1024 pixels, whichever
 * comes first, and forcibly loses the oldest past either. A 600x400 panel at 2x
 * DPR is 960,000 pixels, so seventeen live panels exhaust the budget. That is why
 * the index page is video posters and this component exists once per item page.
 *
 * Every ambient effect gets a visible pause control. WCAG 2.2.2 Pause, Stop,
 * Hide is Level A, and it describes every background in this library.
 */

type Props = {
  slug: string
  name: string
  tier: 1 | 2
  category: string
  /**
   * The background the item is tuned against. Required, like the field it
   * comes from: a panel that quietly falls back to paper is how every
   * undeclared item came to be shown on a ground nobody chose for it.
   */
  ground: 'paper' | 'dark' | 'either'
  instruction?: string | undefined
  oneShot: boolean
  options: Record<string, Record<string, unknown>>
}

const { slug, name, tier, category, ground, instruction, oneShot, options } = Astro.props

/*
 * Tier 2 is React, and the way Astro consumes React is an island. Mounting it
 * from the panel's own script tag instead works in a build and breaks in dev: the
 * react plugin injects its refresh preamble into a page only when there is an
 * island on it, and the code it compiles the component into throws without one.
 *
 * `client:only` rather than `client:load`, because these are demos of
 * interactive behaviour and there is nothing useful to prerender.
 *
 * Written out one per slug rather than looked up in a map, because `client:only`
 * has to match an import statement: Astro resolves the renderer and the island's
 * entry point at compile time and cannot follow a variable.
 */
const island = tier === 2 ? slug : ''

/*
 * The one demo that sets its own height.
 *
 * Every other panel is a 16:9 window onto something that fills whatever window
 * it is given, so a fixed frame costs nothing. A contact sheet is not that: its
 * height is a function of its width and how many plates it holds, and it steps
 * up a whole row at a time as the columns drop. A fixed frame can only crop it,
 * which is what the second row of captions was being cut off by at every width,
 * and what left an empty band under a third row that had nowhere to go.
 *
 * So the panel follows the sheet instead of the sheet being clipped to the
 * panel. Nothing is lost by it: there are no controls on a tier 2 panel to
 * position, and the recording is filmed from the item's own demo.html at fixed
 * ratios rather than from this.
 */
const flows = slug === 'image-gallery-lightbox'

/*
 * A backdrop shown on its own answers the wrong question. The one people ask
 * first is what it would look like behind something, and a 16:9 swatch of
 * pattern does not answer it: it reads as a poster, which is why the loud ones
 * looked fine in isolation and wrong the moment you imagined type over them.
 *
 * So every backdrop is shown in use by default, with a bare view a click away
 * rather than the other way round. The copy is this site's own, because filler
 * is its own kind of lie about how something reads.
 */
const inUse = tier === 1 && category === 'backdrops'

/*
 * Controls are generated from the option schema rather than written per item,
 * because meta.json already carries the type, the range, the step and the
 * default for every option. Writing them by hand would be nineteen copies of
 * the same form that can drift from the thing they are driving.
 *
 * Tier 2 has no `update()` on its handle, so it gets no panel.
 */
/*
 * Items whose demo is itself a surface sitting on a page: a card, a sheet, a
 * plate. The panel is paper for those and the thing inside it is the elevated
 * one, because a card the same colour as the box around it is not a card. Every
 * other panel is elevated, since a shader covers it completely and only the
 * edge of it is ever seen.
 */
const ON_PAPER = new Set([
  'tilt-card',
  'spotlight-card',
  /*
   * EmbossedText is here for a different reason from the cards: a blind emboss
   * paints the letter face the paper colour, so the panel behind it has to be
   * the same paper the item defaults to or the heading reads as a block of
   * slightly wrong white.
   */
  'embossed-text',
  /* StrokeText for the same reason: the hollow of a letter is painted the
     paper colour, because that is what covers the inner half of the stroke. */
  'stroke-text'
])

const tweakable = tier === 1 ? Object.entries(options) : []
---

<figure class="m-0">
  <div
    class:list={[
      'relative overflow-hidden rounded-[2px] border',
      /*
       * The ground decides the panel, and it is set as a class rather than in
       * the stylesheet because `bg-be` is a utility: utilities sit in a later
       * cascade layer than components, so a rule in global.css loses to it
       * whatever its specificity and does so silently.
       */
      ground === 'dark'
        ? 'border-white/15 bg-[#131316]'
        : ON_PAPER.has(slug)
          ? 'border-line bg-b1'
          : 'border-line bg-be'
    ]}
    data-demo
    data-slug={slug}
    data-tier={tier}
    data-ground={ground}
    data-flows={flows ? '' : undefined}
    style={flows ? undefined : 'aspect-ratio: 16 / 9'}
  >
    <div class={flows ? 'relative' : 'absolute inset-0'} data-stage>
      {island === 'fullscreen-menu' && <ContentsDemo client:only="react" />}
      {island === 'sheen-button' && <SheenButtonDemo client:only="react" />}
      {island === 'image-gallery-lightbox' && <PlateDemo client:only="react" />}
      {island === 'glass-nav' && <CrossbarDemo client:only="react" />}
    </div>

    {
      inUse && (
        <div class="demo-use" data-use aria-hidden="true" hidden>
          {/* Off by default, and the control offers to put it there. A backdrop
              should be seen as a backdrop first: the sample hero answers a
              second question, which is whether text survives on it, and that is
              worth asking only once somebody has looked at the thing itself.

              A paragraph, not a heading. It is a picture of a hero rather than
              one, and a real h2 would put a second outline on the page. */}
          <p class="demo-use__title">A headline sits here</p>
          <p class="demo-use__line">
            And a line of supporting copy under it, about the length a real one runs,
            so the backdrop can be judged behind text rather than on its own.
          </p>
        </div>
      )
    }

    <div class="absolute right-3 bottom-3 flex gap-2">
      {
        inUse && (
          <button
            type="button"
            class="demo-control"
            data-use-toggle
            aria-pressed="false"
          >
            In use
          </button>
        )
      }
      {
        tweakable.length > 0 && (
          <button
            type="button"
            class="demo-control"
            data-controls-toggle
            aria-expanded="false"
          >
            Controls
          </button>
        )
      }
      {
        tier === 2 ? null : oneShot ? (
          <button
            type="button"
            class="demo-control"
            data-replay
          >
            Replay
          </button>
        ) : (
          <button
            type="button"
            class="demo-control"
            data-toggle
            aria-pressed="false"
          >
            Pause
          </button>
        )
      }
    </div>
  </div>

  {
    tweakable.length > 0 && (
      <div class="controls" data-controls hidden>
        <script type="application/json" data-schema set:html={JSON.stringify(options)} />
        <div
          class="controls__rows"
          data-controls-rows
          data-1p-ignore="true"
          data-lpignore="true"
          data-bwignore="true"
          data-form-type="other"
        />
        <div class="controls__foot">
          <span class="tag controls__hint">
            Locked options are left alone by Randomise
          </span>
          <div class="controls__actions">
            <button type="button" class="controls__action" data-controls-random>
              Randomise
            </button>
            <button type="button" class="controls__action" data-controls-reset>
              Reset
            </button>
            <button
              type="button"
              class="controls__action controls__action--solid"
              data-controls-copy
              data-factory={`create${name}`}
            >
              Copy options
            </button>
          </div>
        </div>
      </div>
    )
  }

  {
    /*
     * Without a line telling people what to do, half of these look broken to
     * anyone who does not already know to interact. Non-negotiable, and real DOM
     * rather than burnt into the video, so it survives reduced motion and a
     * poster that has not loaded.
     */
  }
  <figcaption class="tag mt-3 flex items-center gap-2">
    <span aria-hidden="true">↳</span>
    {instruction ?? 'ambient, nothing to do'}
  </figcaption>
</figure>

<script>
  import type { EffectHandle } from '@shared/runtime'

  type Mounted = { stop(): void; start(): void; destroy(): void; renderAtTime?(t: number): void }

  // Explicit, not glob. Five items is a list a person can read, and it keeps the
  // bundle honest about what each page actually pulls in.
  const EFFECTS: Record<
    string,
    () => Promise<{ default: (el: HTMLElement, opts?: Record<string, unknown>) => EffectHandle }>
  > = {
    'halftone-backdrop': () => import('@items/effects/halftone-backdrop/core'),
    'cast-shadow-scene': () => import('@items/effects/cast-shadow-scene/core'),
    'pointer-foil-sheen': () => import('@items/effects/pointer-foil-sheen/core'),
    'scramble-text': () => import('@items/effects/scramble-text/core'),
    'decode-text': () => import('@items/effects/decode-text/core'),
    'split-flap-text': () => import('@items/effects/split-flap-text/core'),
    'typewriter-text': () => import('@items/effects/typewriter-text/core'),
    'embossed-text': () => import('@items/effects/embossed-text/core'),
    'circular-text': () => import('@items/effects/circular-text/core'),
    'scroll-reveal-rows': () => import('@items/effects/scroll-reveal-rows/core'),
    'tilt-card': () => import('@items/effects/tilt-card/core'),
    'pointer-ripple-grid': () => import('@items/effects/pointer-ripple-grid/core'),
    'magnetic-button': () => import('@items/effects/magnetic-button/core'),
    'click-spark': () => import('@items/effects/click-spark/core'),
    'crosshair-cursor': () => import('@items/effects/crosshair-cursor/core'),
    'variable-weight-text': () => import('@items/effects/variable-weight-text/core'),
    'split-fountain-text': () => import('@items/effects/split-fountain-text/core'),
    'stroke-text': () => import('@items/effects/stroke-text/core'),
    'masked-heading': () => import('@items/effects/masked-heading/core'),
    'expanding-tiles': () => import('@items/effects/expanding-tiles/core'),
    'rotating-words': () => import('@items/effects/rotating-words/core'),
    'falling-letters': () => import('@items/effects/falling-letters/core'),
    'pointer-lit-busts': () => import('@items/effects/pointer-lit-busts/core'),
    'gradual-blur': () => import('@items/effects/gradual-blur/core'),
    'count-up-number': () => import('@items/effects/count-up-number/core'),
    'odometer-number': () => import('@items/effects/odometer-number/core'),
    'terrain-relief': () => import('@items/effects/terrain-relief/core'),
    'guilloche-lines': () => import('@items/effects/guilloche-lines/core'),
    'mesh-gradient': () => import('@items/effects/mesh-gradient/core'),
    'light-shafts': () => import('@items/effects/light-shafts/core'),
    'lightning-vein': () => import('@items/effects/lightning-vein/core'),
    'moire-screens': () => import('@items/effects/moire-screens/core'),
    'registration-marks': () => import('@items/effects/registration-marks/core'),
    'woven-threads': () => import('@items/effects/woven-threads/core'),
    'dust-motes': () => import('@items/effects/dust-motes/core'),
    'wind-field': () => import('@items/effects/wind-field/core'),
    'ember-rise': () => import('@items/effects/ember-rise/core'),
    'highlighter-mark': () => import('@items/effects/highlighter-mark/core'),
    'iris-reveal': () => import('@items/effects/iris-reveal/core'),
    tooth: () => import('@items/effects/paper-grain/core'),
    'scroll-marquee': () => import('@items/effects/scroll-marquee/core'),
    'aurora-curtain': () => import('@items/effects/aurora-curtain/core'),
    'prism-spectrum': () => import('@items/effects/prism-spectrum/core'),
    'translucent-sheets': () => import('@items/effects/translucent-sheets/core'),
    'scroll-slideshow': () => import('@items/effects/scroll-slideshow/core'),
    'scroll-warp-image': () => import('@items/effects/scroll-warp-image/core'),
    'marbled-paper': () => import('@items/effects/marbled-paper/core'),
    'halftone-reveal': () => import('@items/effects/halftone-reveal/core'),
    'stipple-field': () => import('@items/effects/stipple-field/core'),
    'pointer-filings': () => import('@items/effects/pointer-filings/core'),
    'misprint-text': () => import('@items/effects/misprint-text/core'),
    'spotlight-card': () => import('@items/effects/spotlight-card/core'),
    'pointer-smoke': () => import('@items/effects/pointer-smoke/core'),
    'watermark-sheet': () => import('@items/effects/watermark-sheet/core'),
    'ink-bleed-text': () => import('@items/effects/ink-bleed-text/core'),
    'halftone-magnifier': () => import('@items/effects/halftone-magnifier/core'),
    'relight-image': () => import('@items/effects/relight-image/core'),
    'ascii-image': () => import('@items/effects/ascii-image/core'),
    'card-stack': () => import('@items/effects/card-stack/core'),
    'glass-search-bar': () => import('@items/effects/glass-search-bar/core')
  }

  /*
   * Demo copy is deliberately generic. It used to be the library's own name and
   * the 1530 citation the name comes from, which demonstrates the library
   * rather than the effect: anyone looking at a type treatment is trying to see
   * what it does to a heading on their page, not to read ours.
   */
  const HEADLINE = 'A headline sits here'

  /*
   * A DOM effect animates content that is already there, so the panel has to
   * provide some. A shader effect gets an empty stage and fills it itself.
   */
  const CONTENT: Record<string, string> = {
    /*
     * Spool is a shader effect that still needs DOM content, because its images
     * are the host's own children rather than an option. Scrolling this page is
     * what drives it, so the panel needs nothing else.
     */
    'scroll-slideshow': [
      ['01-rolling-hills', 'Rolling green hills with a line of trees along the crest'],
      ['02-lake-boats', 'Three wooden boats on a turquoise lake below a limestone wall'],
      ['03-misty-river', 'A river running through dark conifers with fog caught in the trees'],
      ['04-flower-pier', 'A path through purple flowers to a jetty, two volcanoes across the water']
    ]
      .map(
        ([file, alt]) =>
          `<img class="demo-scroll-slideshow__plate" src="/plates/scroll-slideshow/${file}.jpg" alt="${alt}" />`
      )
      .join(''),
    'scroll-warp-image':
      '<img class="demo-plate-fill" src="/plates/scroll-warp-image/valley.jpg" alt="A wooded river valley running back to granite cliffs in flat morning light" />',
    'halftone-reveal':
      '<img class="demo-plate-fill" src="/plates/halftone-reveal/plate.jpg" alt="A snow-capped range across a wooded valley under a broken sky" />',
    'halftone-magnifier':
      '<img class="demo-plate-fill" src="/plates/halftone-magnifier/plate.jpg" alt="A ring of stones on a bright green hillside, the sun coming up behind the ridge" />',
    'relight-image':
      '<img class="demo-plate-fill" src="/plates/relight-image/plate.jpg" alt="A grass headland falling away to the sea, with fog lying along the cliff" />',
    'ascii-image':
      '<img class="demo-plate-fill" src="/plates/ascii-image/plate.jpg" alt="A grass headland falling away to the sea, with fog lying along the cliff" />',
    /*
     * The glass is drawn by the canvas; the plate on it is real markup above.
     * WebGL cannot hold text that can be focused, selected, translated or read
     * aloud, so anything practical sitting on glass has to be DOM.
     */
    'glass-search-bar': `<img class="demo-plate-fill" src="/plates/glass-search-bar/mountain.jpg" alt="Mountain ridges at dawn, lit from behind by a pink sky" />
      <form class="demo-capsule" role="search" action="#results">
        <label class="demo-capsule__label" for="demo-capsule-q">Search the library</label>
        <svg class="demo-capsule__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.4" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10.4 10.4 L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <input class="demo-capsule__input" id="demo-capsule-q" type="search" name="q" placeholder="Search the library" autocomplete="off" />
        <button class="demo-capsule__clear" type="reset" aria-label="Clear search"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 4.5 L11.5 11.5 M11.5 4.5 L4.5 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></button>
        <kbd class="demo-capsule__hint">/</kbd>
      </form>`,
    /*
     * The strip is whatever is inside the host, so the panel provides one. Two
     * rows running opposite ways, because one on its own reads as a ticker and
     * two read as a surface being dragged.
     */
    'scroll-marquee': `<div class="demo-strip">
      <span>Available for work</span>
      <span>Available for work</span>
      <span>Available for work</span>
    </div>`,
    /*
     * A paragraph, not an h1. This is sample text inside a demo, and the page
     * already has one h1: its own title. Two of them is a worse outline, and it
     * also meant the review tool measured the rag of a heading that was in the
     * middle of decoding itself and reported on whichever glyph it caught.
     */
    'scramble-text': `<p class="demo-heading">${HEADLINE}</p>`,
    'decode-text': `<p class="demo-heading">${HEADLINE}</p>`,
    'variable-weight-text': `<p class="demo-heading">${HEADLINE}</p>`,
    /* Mounted on the sheet rather than on the heading: one pass of ink across
       everything in the panel, in register. */
    'split-fountain-text': `<div class="demo-fountain">
      <p class="demo-fountain__rule">One pass of ink</p>
      <h2>Two inks in the same duct</h2>
      <p>The rollers blend them where they meet, so the gradient belongs to the sheet and not to the letters.</p>
    </div>`,
    /* A board wants board words, and short ones: four layers of DOM a character. */
    'split-flap-text': `<div class="demo-board">Departures</div>`,
    /* A sentence with punctuation in it, because the breath at a full stop is
       half of what this item is. */
    'typewriter-text': `<p class="demo-typed">Dear Sir, I write about the matter of the press.</p>`,
    'embossed-text': `<p class="demo-heading">${HEADLINE}</p>`,
    'stroke-text': `<p class="demo-heading">${HEADLINE}</p>`,
    /* Four plates in a div. The effect positions them and puts every property
       back on destroy, so this stays ordinary markup. */
    'card-stack': `<div class="demo-pile">
      <article class="demo-plate"><span class="demo-plate__mark"></span><div><h3>Letterpress</h3><p>Handset, one colour, on mould-made paper.</p></div></article>
      <article class="demo-plate"><span class="demo-plate__mark"></span><div><h3>Lithography</h3><p>Four plates, wet on wet, off an offset press.</p></div></article>
      <article class="demo-plate"><span class="demo-plate__mark"></span><div><h3>Screen print</h3><p>Two pulls, the second once the first is dry.</p></div></article>
      <article class="demo-plate"><span class="demo-plate__mark"></span><div><h3>Risograph</h3><p>Soy ink, out of register on purpose.</p></div></article>
    </div>`,
    /* On the block, not the line: one sheet comes off all of it together. */
    'falling-letters': `<p class="demo-pied">Pied type</p>`,
    'rotating-words': `<p class="demo-rotating">Printed by <span class="demo-rotating__set"><span>letterpress</span><span>lithography</span><span>screen print</span><span>risograph</span></span></p>`,
    'expanding-tiles': `<div class="demo-tiles">
      <a class="demo-tiles__tile" href="#letterpress"><span class="demo-tiles__n">01</span><span class="demo-tiles__t">Letterpress</span></a>
      <a class="demo-tiles__tile" href="#lithography"><span class="demo-tiles__n">02</span><span class="demo-tiles__t">Lithography</span></a>
      <a class="demo-tiles__tile" href="#screen-print"><span class="demo-tiles__n">03</span><span class="demo-tiles__t">Screen print</span></a>
      <a class="demo-tiles__tile" href="#risograph"><span class="demo-tiles__n">04</span><span class="demo-tiles__t">Risograph</span></a>
      <a class="demo-tiles__tile" href="#gravure"><span class="demo-tiles__n">05</span><span class="demo-tiles__t">Gravure</span></a>
      <a class="demo-tiles__tile" href="#collotype"><span class="demo-tiles__n">06</span><span class="demo-tiles__t">Collotype</span></a>
    </div>`,
    'masked-heading': `<div class="demo-uncover">
      <p class="demo-uncover__head">Uncovered, not wiped</p>
      <p class="demo-uncover__note">A straight-edged mask crossing a heading is a wipe, and the eye reads that edge as a machine.</p>
    </div>`,
    /*
     * Real <mark> elements, because that is the item's whole interface and the
     * panel should demonstrate the thing people will paste rather than a
     * version of it with spans in.
     */
    'highlighter-mark': `<div class="demo-marked">
      <p class="demo-marked__text">Every version of this keeps <mark>an array of particles</mark>, advances each one every frame, and respawns the ones that drift out. That buys nothing and costs three things: <mark>it cannot be seeked</mark>, it drifts on a dropped frame, and <mark>the trail is feedback</mark>.</p>
    </div>`,
    /*
     * The iris clips whatever it is mounted on, so the panel has to give it
     * something with an edge and a subject. The plate is one block, because an
     * iris opens on a scene rather than on each thing in it.
     */
    'iris-reveal': `<div class="demo-iris">
      <p class="demo-iris__head">Seven blades, not a circle</p>
      <p class="demo-iris__note">A diaphragm is a ring of overlapping plates, so the hole they leave has as many sides as there are blades, and it turns as it opens.</p>
    </div>`,
    /* The ring fills the box it is given, so the box is the size control. */
    'circular-text': `<div class="demo-seal">Printed and bound in England</div>`,
    'misprint-text': `<p class="demo-heading">${HEADLINE}</p>`,
    'ink-bleed-text': `<p class="demo-heading">${HEADLINE}</p>`,
    /*
     * Short labels, matching the item's own demo. The full names wrapped to two
     * lines in this column, which made every other row twice the height of the
     * one above it and the stagger land on a list that looked broken before it
     * had finished arriving.
     */
    'scroll-reveal-rows': `<div class="demo-list">
      <div><span>Overprint</span><span>shader</span></div>
      <div><span>Sundial</span><span>three</span></div>
      <div><span>Foil</span><span>pointer</span></div>
      <div><span>Sort</span><span>type</span></div>
      <div><span>Riser</span><span>reveal</span></div>
      <div><span>Tilt</span><span>surface</span></div>
    </div>`,
    'count-up-number': `<div class="demo-count-up-number">
      <span class="demo-count-up-number__value">45,400</span>
      <p>Stars on the library we are not competing with</p>
    </div>`,
    /* Mounted on the wheels, with the caption outside them, the same way the
       count-up panel is put together. */
    'odometer-number': `<div class="demo-count-up-number">
      <span class="demo-odometer">128640</span>
      <p>Miles since the last service</p>
    </div>`,
    /* A column of text under the band, so there is something to go out of
       focus. The pane clips it; the haze is at the pane's own foot. */
    'gradual-blur': `<div class="demo-haze">
      <h2>On the setting of a page</h2>
      <p>A band at the edge where the content goes out of focus before it runs off, rather than a fade to the colour of the paper.</p>
      <p>The difference is that a fade tells you the text has stopped, and a haze tells you it has not.</p>
      <p>The ramp is built out of several blurs, each one twice as hard as the one below it and masked to its own band.</p>
      <p>Because a backdrop filter sees everything painted beneath it, the blurs compound as they stack.</p>
    </div>`,
    /* Three buttons, because the point is what the reticle does when it crosses
       one: it leaves the cursor and squares up around it. */
    'crosshair-cursor': `<div class="demo-reticle">
      <button type="button">Dispatch</button>
      <button type="button">Hold for collection</button>
      <button type="button">Cancel</button>
    </div>`,
    /* Mounted on the sheet rather than on the button, so the sparks are sized
       against the area they are thrown into. The button inside keeps working. */
    'click-spark': `<div class="demo-spark-sheet">
      <button type="button" class="beamish-sheen-button beamish-sheen-button--solid">Press me</button>
    </div>`,
    'magnetic-button': `<div class="demo-magnetic-button">
      <div class="demo-magnetic-button__rest" aria-hidden="true"></div>
      <button type="button" class="beamish-sheen-button beamish-sheen-button--solid">Get prompt</button>
    </div>`,
    'tilt-card': `<article class="demo-card">
      <div class="demo-card__mark"></div>
      <div class="demo-card__body">
        <h2>A card title goes here</h2>
        <p class="demo-card__note">And a line of supporting copy under it.</p>
      </div>
    </article>`,
    'spotlight-card': `<article class="demo-card">
      <div class="demo-card__mark"></div>
      <div class="demo-card__body">
        <h2>A card title goes here</h2>
        <p class="demo-card__note">And a line of supporting copy under it.</p>
      </div>
    </article>`
  }

  /*
   * Options the panel mounts with. Tally needs an explicit locale: Intl follows
   * the browser's language setting, not the document's lang attribute, so a
   * visitor whose browser is set to German sees 45.400 on an en-GB page.
   */
  const OPTIONS: Record<string, Record<string, unknown>> = {
    'count-up-number': { locale: 'en-GB' },
    /*
     * The tiles are links, and on a real page following them is the whole
     * gesture. Here it would walk the reader off the item page they are reading,
     * so the panel shows the opening and the closing instead.
     */
    'expanding-tiles': { follow: false }
  }

  /* Where inside the injected markup the effect actually mounts. */
  const MOUNT_ON: Record<string, string> = {
    'magnetic-button': '.beamish-sheen-button',
    'count-up-number': '.demo-count-up-number__value',
    'odometer-number': '.demo-odometer',
    'card-stack': '.demo-pile',
    'expanding-tiles': '.demo-tiles',
    'rotating-words': '.demo-rotating__set',
    'falling-letters': '.demo-pied',
    // The lamp lights the card, not the stage around it.
    'spotlight-card': '.demo-card'
  }

  /*
   * Effects that need DOM content and still draw into a canvas filling the
   * panel. Spool's <img> children are the pictures it samples, not the thing
   * being animated, so it mounts on the stage rather than on the first child,
   * and the centring styles for DOM content must not apply to it.
   */
  const CANVAS_WITH_CONTENT = new Set([
    'scroll-slideshow',
    'scroll-warp-image',
    'halftone-reveal',
    'halftone-magnifier',
    'relight-image',
    'glass-search-bar'
  ])

  for (const panel of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const slug = panel.dataset['slug'] ?? ''
    const tier = panel.dataset['tier'] === '2' ? 2 : 1
    const stage = panel.querySelector<HTMLElement>('[data-stage]')
    if (!stage) continue

    // Tier 2 is hydrated by Astro as an island. Nothing to mount, nothing to
    // pause, and no option schema to drive.
    if (tier !== 1) continue

    let handle: Mounted | null = null

    {
      const load = EFFECTS[slug]
      if (!load) continue
      const markup = CONTENT[slug]
      const drawsToCanvas = CANVAS_WITH_CONTENT.has(slug)
      if (markup) {
        stage.innerHTML = markup
        // Marks the stage as holding DOM content, so the centring styles apply
        // to it and not to a canvas that should fill the panel.
        if (!drawsToCanvas) stage.setAttribute('data-content', '')

        /*
         * Hide the picture now rather than letting the effect do it on mount.
         *
         * There is an await between this line and the mount, and the image
         * decodes and paints during it, so a reveal that is supposed to start
         * from blank paper showed the finished photograph for a frame first and
         * then blanked it. The effect hides it too, for anyone using it
         * directly; this is about the gap.
         *
         * Only for the effects that draw the picture themselves. A DOM effect's
         * images are its content and hiding them would leave an empty panel.
         */
        if (drawsToCanvas) {
          for (const img of stage.querySelectorAll('img')) img.style.visibility = 'hidden'
        }
      }
      const module = await load()
      // A DOM effect wants the element holding the content, not the stage.
      const inner = MOUNT_ON[slug]
      const target =
        markup && !drawsToCanvas
          ? ((inner ? stage.querySelector<HTMLElement>(inner) : stage.firstElementChild) as HTMLElement)
          : stage
      const effect = module.default(target, OPTIONS[slug])
      effect.start()
      handle = effect
    }

    // One live context per page, released the moment the page goes away, so
    // navigating between item pages cannot accumulate contexts.
    addEventListener('pagehide', () => handle?.destroy(), { once: true })

    const toggle = panel.querySelector<HTMLButtonElement>('[data-toggle]')
    toggle?.addEventListener('click', () => {
      const paused = toggle.getAttribute('aria-pressed') === 'true'
      if (paused) handle?.start()
      else handle?.stop()
      toggle.setAttribute('aria-pressed', String(!paused))
      toggle.textContent = paused ? 'Pause' : 'Play'
    })

    const use = panel.querySelector<HTMLElement>('[data-use]')
    const useToggle = panel.querySelector<HTMLButtonElement>('[data-use-toggle]')
    useToggle?.addEventListener('click', () => {
      const shown = useToggle.getAttribute('aria-pressed') === 'true'
      use?.toggleAttribute('hidden', shown)
      useToggle.setAttribute('aria-pressed', String(!shown))
      useToggle.textContent = shown ? 'In use' : 'Bare'
    })

    const replay = panel.querySelector<HTMLButtonElement>('[data-replay]')
    replay?.addEventListener('click', () => {
      handle?.stop()
      // start() does not rewind. A one-shot that has already finished would
      // otherwise resume at the end and appear to do nothing.
      handle?.renderAtTime?.(0)
      handle?.start()
    })

    // --- controls --------------------------------------------------------

    /*
     * Built from the option schema rather than written per item. meta.json
     * already carries the type, range, step and default of every option, so the
     * panel is a view of that and cannot drift from what the effect accepts.
     */
    const controls = panel.parentElement?.querySelector<HTMLElement>('[data-controls]')
    const schemaTag = controls?.querySelector<HTMLScriptElement>('[data-schema]')
    const rows = controls?.querySelector<HTMLElement>('[data-controls-rows]')

    if (controls && schemaTag && rows && handle && 'update' in handle) {
      type Spec = {
        type: 'number' | 'color' | 'boolean' | 'string' | 'enum'
        default: unknown
        min?: number
        max?: number
        step?: number
        values?: string[]
        description?: string
      }
      const schema = JSON.parse(schemaTag.textContent || '{}') as Record<string, Spec>

      // The panel mounts some items with overrides, so the starting point is
      // what is actually on screen rather than what the schema says.
      const start: Record<string, unknown> = {}
      for (const [key, spec] of Object.entries(schema)) start[key] = spec.default
      Object.assign(start, OPTIONS[slug] ?? {})

      const current: Record<string, unknown> = { ...start }
      const locked = new Set<string>()
      const inputs = new Map<string, HTMLInputElement | HTMLSelectElement>()
      const readouts = new Map<string, HTMLElement>()

      const show = (key: string) => {
        const v = current[key]
        const out = readouts.get(key)
        if (out) out.textContent = typeof v === 'number' ? String(Number(v.toFixed(4))) : String(v)
      }

      const apply = () => (handle as { update(o: Record<string, unknown>): void }).update(current)

      for (const [key, spec] of Object.entries(schema)) {
        const row = document.createElement('div')
        row.className = 'controls__row'

        const id = 'c-' + slug + '-' + key
        const label = document.createElement('label')
        label.className = 'controls__label'
        label.textContent = key
        label.htmlFor = id

        let input: HTMLInputElement | HTMLSelectElement
        if (spec.type === 'number') {
          input = document.createElement('input')
          input.type = 'range'
          input.min = String(spec.min ?? 0)
          input.max = String(spec.max ?? 1)
          input.step = String(spec.step ?? 0.01)
          input.value = String(current[key])
        } else if (spec.type === 'color') {
          input = document.createElement('input')
          input.type = 'color'
          input.value = String(current[key])
        } else if (spec.type === 'boolean') {
          input = document.createElement('input')
          input.type = 'checkbox'
          input.checked = Boolean(current[key])
        } else if (spec.type === 'enum') {
          input = document.createElement('select')
          for (const value of spec.values ?? []) {
            const opt = document.createElement('option')
            opt.value = value
            opt.textContent = value
            input.append(opt)
          }
          input.value = String(current[key])
        } else {
          input = document.createElement('input')
          input.type = 'text'
          input.value = String(current[key])
        }
        input.id = id
        /*
         * Named, and opted out of autofill. These are sliders and colour
         * swatches, never credentials, so a password manager has no business
         * in them: it decorates a colour input with a key icon, and at least
         * one popular extension maps over the page's fields and lowercases a
         * property that is not there, which throws inside the extension and
         * lands in our console looking like our bug. A field with no name is
         * what trips it. The search box next door has always had both.
         */
        input.name = id
        input.autocomplete = 'off'
        input.className = 'controls__input controls__input--' + spec.type
        // What Reset returns to, recorded on the element so the value is
        // inspectable rather than only living in a closure.
        input.dataset['start'] = String(current[key])
        if (spec.description) input.title = spec.description

        const readout = document.createElement('output')
        readout.className = 'controls__value'
        readout.htmlFor = id

        /*
         * A lock per row, so Randomise can leave the things you have already
         * settled on. Without it randomising is all or nothing and you lose the
         * one value you were happy with every time you press it.
         */
        const lock = document.createElement('button')
        lock.type = 'button'
        lock.className = 'controls__lock'
        lock.setAttribute('aria-pressed', 'false')
        /*
         * No text. The state is carried by aria-pressed for anything reading
         * the page and by a drawn box for anything looking at it. The word
         * repeated down twelve rows was the loudest thing in the panel, and it
         * was saying the same thing every time.
         */
        lock.setAttribute('aria-label', 'Lock ' + key + ' against randomise')
        lock.addEventListener('click', () => {
          const on = locked.has(key)
          if (on) locked.delete(key)
          else locked.add(key)
          lock.setAttribute('aria-pressed', String(!on))
        })

        input.addEventListener('input', () => {
          const el = input as HTMLInputElement
          current[key] =
            spec.type === 'number'
              ? Number(el.value)
              : spec.type === 'boolean'
                ? el.checked
                : el.value
          show(key)
          apply()
        })

        row.append(label, input, readout, lock)
        rows.append(row)
        inputs.set(key, input)
        readouts.set(key, readout)
        show(key)
      }

      const writeBack = () => {
        for (const [key, input] of inputs) {
          const spec = schema[key]!
          if (spec.type === 'boolean') (input as HTMLInputElement).checked = Boolean(current[key])
          else input.value = String(current[key])
          show(key)
        }
        apply()
      }

      controls.parentElement
        ?.querySelector<HTMLButtonElement>('[data-controls-toggle]')
        ?.addEventListener('click', event => {
          const button = event.currentTarget as HTMLButtonElement
          const open = button.getAttribute('aria-expanded') === 'true'
          button.setAttribute('aria-expanded', String(!open))
          controls.hidden = open
        })

      controls.querySelector('[data-controls-reset]')?.addEventListener('click', () => {
        Object.assign(current, start)
        writeBack()
      })

      /*
       * Numbers only, and inside the schema's own range. Randomising the
       * colours as well produces something that is no longer on paper, which is
       * the one thing every effect here is supposed to be.
       */
      controls.querySelector('[data-controls-random]')?.addEventListener('click', () => {
        for (const [key, spec] of Object.entries(schema)) {
          if (locked.has(key) || spec.type !== 'number') continue
          const min = spec.min ?? 0
          const max = spec.max ?? 1
          const step = spec.step ?? 0.01
          const steps = Math.max(1, Math.round((max - min) / step))
          current[key] = Number((min + Math.round(Math.random() * steps) * step).toFixed(6))
        }
        writeBack()
      })

      /*
       * Only what differs from the default. The whole point is to paste the
       * result into your own code, and forty lines of values you never touched
       * is not a thing anybody wants to read back.
       */
      controls.querySelector('[data-controls-copy]')?.addEventListener('click', async event => {
        const button = event.currentTarget as HTMLButtonElement
        const changed = Object.entries(current).filter(
          ([key, value]) => String(value) !== String(schema[key]?.default)
        )
        const lines = changed.map(
          ([k, v]) => '  ' + k + ': ' + (typeof v === 'string' ? "'" + v + "'" : v)
        )
        const body = changed.length ? ', {\n' + lines.join(',\n') + '\n}' : ''
        const factory = button.dataset['factory'] ?? 'createEffect'
        const text = factory + '(el' + body + ')'
        try {
          await navigator.clipboard.writeText(text)
          button.textContent = changed.length ? 'Copied ' + changed.length : 'Copied defaults'
        } catch {
          button.textContent = 'Press ctrl C'
        }
        setTimeout(() => (button.textContent = 'Copy options'), 1600)
      })
    }
  }
</script>
