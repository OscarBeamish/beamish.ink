---
import '@items/components/glow-button/styles.css'
/*
 * One live demo, and never more than one on a page.
 *
 * Chromium allows 16 WebGL contexts *or* 16 × 1024 × 1024 pixels, whichever
 * comes first, and forcibly loses the oldest past either. A 600x400 panel at 2x
 * DPR is 960,000 pixels, so seventeen live panels exhaust the budget. That is why
 * the index page is video posters and this component exists once per item page.
 *
 * Every ambient effect gets a visible pause control. WCAG 2.2.2 Pause, Stop,
 * Hide is Level A, and it describes every background in this library.
 */

type Props = {
  slug: string
  name: string
  tier: 1 | 2
  instruction?: string | undefined
  oneShot: boolean
  options: Record<string, Record<string, unknown>>
}

const { slug, name, tier, instruction, oneShot, options } = Astro.props

/*
 * Controls are generated from the option schema rather than written per item,
 * because meta.json already carries the type, the range, the step and the
 * default for every option. Writing them by hand would be nineteen copies of
 * the same form that can drift from the thing they are driving.
 *
 * Tier 2 has no `update()` on its handle, so it gets no panel.
 */
const tweakable = tier === 1 ? Object.entries(options) : []
---

<figure class="m-0">
  <div
    class="border-line bg-be relative overflow-hidden rounded-[2px] border"
    data-demo
    data-slug={slug}
    data-tier={tier}
    style="aspect-ratio: 16 / 9"
  >
    <div class="absolute inset-0" data-stage></div>

    <div class="absolute right-3 bottom-3 flex gap-2">
      {
        tweakable.length > 0 && (
          <button
            type="button"
            class="border-control text-l1 rounded-full border bg-transparent px-3 py-1.5 text-[0.65rem] tracking-[0.1em] uppercase backdrop-blur-sm"
            data-controls-toggle
            aria-expanded="false"
          >
            Controls
          </button>
        )
      }
      {
        oneShot ? (
          <button
            type="button"
            class="border-control text-l1 rounded-full border bg-transparent px-3 py-1.5 text-[0.65rem] tracking-[0.1em] uppercase backdrop-blur-sm"
            data-replay
          >
            Replay
          </button>
        ) : (
          <button
            type="button"
            class="border-control text-l1 rounded-full border bg-transparent px-3 py-1.5 text-[0.65rem] tracking-[0.1em] uppercase backdrop-blur-sm"
            data-toggle
            aria-pressed="false"
          >
            Pause
          </button>
        )
      }
    </div>
  </div>

  {
    tweakable.length > 0 && (
      <div class="controls" data-controls hidden>
        <script type="application/json" data-schema set:html={JSON.stringify(options)} />
        <div class="controls__rows" data-controls-rows />
        <div class="controls__foot">
          <span class="tag controls__hint">
            Locked options are left alone by Randomise
          </span>
          <div class="controls__actions">
            <button type="button" class="controls__action" data-controls-random>
              Randomise
            </button>
            <button type="button" class="controls__action" data-controls-reset>
              Reset
            </button>
            <button
              type="button"
              class="controls__action controls__action--solid"
              data-controls-copy
              data-factory={`create${name}`}
            >
              Copy options
            </button>
          </div>
        </div>
      </div>
    )
  }

  {
    /*
     * Without a line telling people what to do, half of these look broken to
     * anyone who does not already know to interact. Non-negotiable, and real DOM
     * rather than burnt into the video, so it survives reduced motion and a
     * poster that has not loaded.
     */
  }
  <figcaption class="tag mt-3 flex items-center gap-2">
    <span aria-hidden="true">↳</span>
    {instruction ?? 'ambient, nothing to do'}
  </figcaption>
</figure>

<script>
  import type { EffectHandle } from '@shared/runtime'

  type Mounted = { stop(): void; start(): void; destroy(): void; renderAtTime?(t: number): void }

  // Explicit, not glob. Five items is a list a person can read, and it keeps the
  // bundle honest about what each page actually pulls in.
  const EFFECTS: Record<
    string,
    () => Promise<{ default: (el: HTMLElement, opts?: Record<string, unknown>) => EffectHandle }>
  > = {
    'halftone-backdrop': () => import('@items/effects/halftone-backdrop/core'),
    'cast-shadow-scene': () => import('@items/effects/cast-shadow-scene/core'),
    'pointer-foil-sheen': () => import('@items/effects/pointer-foil-sheen/core'),
    'scramble-text': () => import('@items/effects/scramble-text/core'),
    'scroll-reveal-rows': () => import('@items/effects/scroll-reveal-rows/core'),
    'tilt-card': () => import('@items/effects/tilt-card/core'),
    'pointer-ripple-grid': () => import('@items/effects/pointer-ripple-grid/core'),
    'magnetic-button': () => import('@items/effects/magnetic-button/core'),
    'count-up-number': () => import('@items/effects/count-up-number/core'),
    'terrain-relief': () => import('@items/effects/terrain-relief/core'),
    'guilloche-lines': () => import('@items/effects/guilloche-lines/core'),
    'translucent-sheets': () => import('@items/effects/translucent-sheets/core'),
    'scroll-slideshow': () => import('@items/effects/scroll-slideshow/core'),
    'scroll-warp-image': () => import('@items/effects/scroll-warp-image/core'),
    'marbled-paper': () => import('@items/effects/marbled-paper/core'),
    'halftone-reveal': () => import('@items/effects/halftone-reveal/core'),
    'stipple-field': () => import('@items/effects/stipple-field/core'),
    'pointer-filings': () => import('@items/effects/pointer-filings/core'),
    'misprint-text': () => import('@items/effects/misprint-text/core'),
    'spotlight-card': () => import('@items/effects/spotlight-card/core'),
    'pointer-trail': () => import('@items/effects/pointer-trail/core'),
    'watermark-sheet': () => import('@items/effects/watermark-sheet/core')
  }

  const COMPONENTS: Record<string, () => Promise<{ mount(el: HTMLElement): Mounted }>> = {
    'fullscreen-menu': async () => {
      const [{ Contents }, react, dom, demo] = await Promise.all([
        import('@items/components/fullscreen-menu/react'),
        import('react'),
        import('react-dom/client'),
        import('../demos/contents')
      ])
      return {
        mount(el) {
          const root = dom.createRoot(el)
          root.render(react.createElement(Contents, demo.props))
          return { start() {}, stop() {}, destroy: () => root.unmount() }
        }
      }
    },
    'glow-button': async () => {
      const [{ Ember }, react, dom, demo] = await Promise.all([
        import('@items/components/glow-button/react'),
        import('react'),
        import('react-dom/client'),
        import('../demos/ember')
      ])
      return {
        mount(el) {
          const root = dom.createRoot(el)
          root.render(demo.render(react.createElement, Ember))
          return { start() {}, stop() {}, destroy: () => root.unmount() }
        }
      }
    },
    'image-gallery-lightbox': async () => {
      const [{ Plate }, react, dom, demo] = await Promise.all([
        import('@items/components/image-gallery-lightbox/react'),
        import('react'),
        import('react-dom/client'),
        import('../demos/plate')
      ])
      return {
        mount(el) {
          const root = dom.createRoot(el)
          root.render(react.createElement(Plate, demo.props))
          return { start() {}, stop() {}, destroy: () => root.unmount() }
        }
      }
    }
  }

  /*
   * A DOM effect animates content that is already there, so the panel has to
   * provide some. A shader effect gets an empty stage and fills it itself.
   */
  const CONTENT: Record<string, string> = {
    /*
     * Spool is a shader effect that still needs DOM content, because its images
     * are the host's own children rather than an option. Scrolling this page is
     * what drives it, so the panel needs nothing else.
     */
    'scroll-slideshow': [
      ['01-curved-facade', 'A curved concrete apartment block, its balconies banding round the corner'],
      ['02-perforated-grid', 'A facade of small square windows punched in a dark grid, seen from above'],
      ['03-concrete-stair', 'Concrete stairs crossing back on themselves behind black steel railings'],
      ['04-spiral-stair', 'A spiral stair curving down the inside of a circular concrete well']
    ]
      .map(
        ([file, alt]) =>
          `<img class="demo-scroll-slideshow__plate" src="/plates/scroll-slideshow/${file}.jpg" alt="${alt}" />`
      )
      .join(''),
    'scroll-warp-image':
      '<img class="demo-plate-fill" src="/plates/scroll-warp-image/grid.jpg" alt="A facade of small square windows punched in a dark grid, seen from above" />',
    'halftone-reveal':
      '<img class="demo-plate-fill" src="/plates/halftone-reveal/plate.jpg" alt="A spiral stair curving down the inside of a circular concrete well" />',
    'scramble-text': '<h1 class="demo-heading">Come to my arms, my beamish boy</h1>',
    'misprint-text': '<h1 class="demo-heading">Out of register</h1>',
    'scroll-reveal-rows': `<div class="demo-list">
      <div><span>Halftone Backdrop</span><span>shader</span></div>
      <div><span>Cast Shadow Scene</span><span>three</span></div>
      <div><span>Pointer Foil Sheen</span><span>pointer</span></div>
      <div><span>Scramble Text</span><span>type</span></div>
      <div><span>Scroll Reveal Rows</span><span>reveal</span></div>
    </div>`,
    'count-up-number': `<div class="demo-count-up-number">
      <span class="demo-count-up-number__value">45,400</span>
      <p>Stars on the library we are not competing with</p>
    </div>`,
    'magnetic-button': `<div class="demo-magnetic-button">
      <div class="demo-magnetic-button__rest" aria-hidden="true"></div>
      <button type="button" class="beamish-glow-button beamish-glow-button--solid">Get prompt</button>
    </div>`,
    'tilt-card': `<article class="demo-card">
      <div class="demo-card__mark"></div>
      <div>
        <p class="demo-card__tag">Surfaces</p>
        <h2>Beamysshe as the sonne is</h2>
      </div>
      <p class="demo-card__note">John Palsgrave, 1530.</p>
    </article>`,
    'spotlight-card': `<article class="demo-card">
      <div class="demo-card__mark"></div>
      <div>
        <p class="demo-card__tag">Surfaces</p>
        <h2>Beamysshe as the sonne is</h2>
      </div>
      <p class="demo-card__note">John Palsgrave, 1530.</p>
    </article>`
  }

  /*
   * Options the panel mounts with. Tally needs an explicit locale: Intl follows
   * the browser's language setting, not the document's lang attribute, so a
   * visitor whose browser is set to German sees 45.400 on an en-GB page.
   */
  const OPTIONS: Record<string, Record<string, unknown>> = {
    'count-up-number': { locale: 'en-GB' }
  }

  /* Where inside the injected markup the effect actually mounts. */
  const MOUNT_ON: Record<string, string> = {
    'magnetic-button': '.beamish-glow-button',
    'count-up-number': '.demo-count-up-number__value',
    // The lamp lights the card, not the stage around it.
    'spotlight-card': '.demo-card'
  }

  /*
   * Effects that need DOM content and still draw into a canvas filling the
   * panel. Spool's <img> children are the pictures it samples, not the thing
   * being animated, so it mounts on the stage rather than on the first child,
   * and the centring styles for DOM content must not apply to it.
   */
  const CANVAS_WITH_CONTENT = new Set(['scroll-slideshow', 'scroll-warp-image', 'halftone-reveal'])

  for (const panel of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const slug = panel.dataset['slug'] ?? ''
    const tier = panel.dataset['tier'] === '2' ? 2 : 1
    const stage = panel.querySelector<HTMLElement>('[data-stage]')
    if (!stage) continue

    let handle: Mounted | null = null

    if (tier === 1) {
      const load = EFFECTS[slug]
      if (!load) continue
      const markup = CONTENT[slug]
      const drawsToCanvas = CANVAS_WITH_CONTENT.has(slug)
      if (markup) {
        stage.innerHTML = markup
        // Marks the stage as holding DOM content, so the centring styles apply
        // to it and not to a canvas that should fill the panel.
        if (!drawsToCanvas) stage.setAttribute('data-content', '')
      }
      const module = await load()
      // A DOM effect wants the element holding the content, not the stage.
      const inner = MOUNT_ON[slug]
      const target =
        markup && !drawsToCanvas
          ? ((inner ? stage.querySelector<HTMLElement>(inner) : stage.firstElementChild) as HTMLElement)
          : stage
      const effect = module.default(target, OPTIONS[slug])
      effect.start()
      handle = effect
    } else {
      const load = COMPONENTS[slug]
      if (!load) continue
      handle = (await load()).mount(stage)
    }

    // One live context per page, released the moment the page goes away, so
    // navigating between item pages cannot accumulate contexts.
    addEventListener('pagehide', () => handle?.destroy(), { once: true })

    const toggle = panel.querySelector<HTMLButtonElement>('[data-toggle]')
    toggle?.addEventListener('click', () => {
      const paused = toggle.getAttribute('aria-pressed') === 'true'
      if (paused) handle?.start()
      else handle?.stop()
      toggle.setAttribute('aria-pressed', String(!paused))
      toggle.textContent = paused ? 'Pause' : 'Play'
    })

    const replay = panel.querySelector<HTMLButtonElement>('[data-replay]')
    replay?.addEventListener('click', () => {
      handle?.stop()
      // start() does not rewind. A one-shot that has already finished would
      // otherwise resume at the end and appear to do nothing.
      handle?.renderAtTime?.(0)
      handle?.start()
    })

    // --- controls --------------------------------------------------------

    /*
     * Built from the option schema rather than written per item. meta.json
     * already carries the type, range, step and default of every option, so the
     * panel is a view of that and cannot drift from what the effect accepts.
     */
    const controls = panel.parentElement?.querySelector<HTMLElement>('[data-controls]')
    const schemaTag = controls?.querySelector<HTMLScriptElement>('[data-schema]')
    const rows = controls?.querySelector<HTMLElement>('[data-controls-rows]')

    if (controls && schemaTag && rows && handle && 'update' in handle) {
      type Spec = {
        type: 'number' | 'color' | 'boolean' | 'string' | 'enum'
        default: unknown
        min?: number
        max?: number
        step?: number
        values?: string[]
        description?: string
      }
      const schema = JSON.parse(schemaTag.textContent || '{}') as Record<string, Spec>

      // The panel mounts some items with overrides, so the starting point is
      // what is actually on screen rather than what the schema says.
      const start: Record<string, unknown> = {}
      for (const [key, spec] of Object.entries(schema)) start[key] = spec.default
      Object.assign(start, OPTIONS[slug] ?? {})

      const current: Record<string, unknown> = { ...start }
      const locked = new Set<string>()
      const inputs = new Map<string, HTMLInputElement | HTMLSelectElement>()
      const readouts = new Map<string, HTMLElement>()

      const show = (key: string) => {
        const v = current[key]
        const out = readouts.get(key)
        if (out) out.textContent = typeof v === 'number' ? String(Number(v.toFixed(4))) : String(v)
      }

      const apply = () => (handle as { update(o: Record<string, unknown>): void }).update(current)

      for (const [key, spec] of Object.entries(schema)) {
        const row = document.createElement('div')
        row.className = 'controls__row'

        const id = 'c-' + slug + '-' + key
        const label = document.createElement('label')
        label.className = 'controls__label'
        label.textContent = key
        label.htmlFor = id

        let input: HTMLInputElement | HTMLSelectElement
        if (spec.type === 'number') {
          input = document.createElement('input')
          input.type = 'range'
          input.min = String(spec.min ?? 0)
          input.max = String(spec.max ?? 1)
          input.step = String(spec.step ?? 0.01)
          input.value = String(current[key])
        } else if (spec.type === 'color') {
          input = document.createElement('input')
          input.type = 'color'
          input.value = String(current[key])
        } else if (spec.type === 'boolean') {
          input = document.createElement('input')
          input.type = 'checkbox'
          input.checked = Boolean(current[key])
        } else if (spec.type === 'enum') {
          input = document.createElement('select')
          for (const value of spec.values ?? []) {
            const opt = document.createElement('option')
            opt.value = value
            opt.textContent = value
            input.append(opt)
          }
          input.value = String(current[key])
        } else {
          input = document.createElement('input')
          input.type = 'text'
          input.value = String(current[key])
        }
        input.id = id
        input.className = 'controls__input controls__input--' + spec.type
        // What Reset returns to, recorded on the element so the value is
        // inspectable rather than only living in a closure.
        input.dataset['start'] = String(current[key])
        if (spec.description) input.title = spec.description

        const readout = document.createElement('output')
        readout.className = 'controls__value'
        readout.htmlFor = id

        /*
         * A lock per row, so Randomise can leave the things you have already
         * settled on. Without it randomising is all or nothing and you lose the
         * one value you were happy with every time you press it.
         */
        const lock = document.createElement('button')
        lock.type = 'button'
        lock.className = 'controls__lock'
        lock.setAttribute('aria-pressed', 'false')
        /*
         * No text. The state is carried by aria-pressed for anything reading
         * the page and by a drawn box for anything looking at it. The word
         * repeated down twelve rows was the loudest thing in the panel, and it
         * was saying the same thing every time.
         */
        lock.setAttribute('aria-label', 'Lock ' + key + ' against randomise')
        lock.addEventListener('click', () => {
          const on = locked.has(key)
          if (on) locked.delete(key)
          else locked.add(key)
          lock.setAttribute('aria-pressed', String(!on))
        })

        input.addEventListener('input', () => {
          const el = input as HTMLInputElement
          current[key] =
            spec.type === 'number'
              ? Number(el.value)
              : spec.type === 'boolean'
                ? el.checked
                : el.value
          show(key)
          apply()
        })

        row.append(label, input, readout, lock)
        rows.append(row)
        inputs.set(key, input)
        readouts.set(key, readout)
        show(key)
      }

      const writeBack = () => {
        for (const [key, input] of inputs) {
          const spec = schema[key]!
          if (spec.type === 'boolean') (input as HTMLInputElement).checked = Boolean(current[key])
          else input.value = String(current[key])
          show(key)
        }
        apply()
      }

      controls.parentElement
        ?.querySelector<HTMLButtonElement>('[data-controls-toggle]')
        ?.addEventListener('click', event => {
          const button = event.currentTarget as HTMLButtonElement
          const open = button.getAttribute('aria-expanded') === 'true'
          button.setAttribute('aria-expanded', String(!open))
          controls.hidden = open
        })

      controls.querySelector('[data-controls-reset]')?.addEventListener('click', () => {
        Object.assign(current, start)
        writeBack()
      })

      /*
       * Numbers only, and inside the schema's own range. Randomising the
       * colours as well produces something that is no longer on paper, which is
       * the one thing every effect here is supposed to be.
       */
      controls.querySelector('[data-controls-random]')?.addEventListener('click', () => {
        for (const [key, spec] of Object.entries(schema)) {
          if (locked.has(key) || spec.type !== 'number') continue
          const min = spec.min ?? 0
          const max = spec.max ?? 1
          const step = spec.step ?? 0.01
          const steps = Math.max(1, Math.round((max - min) / step))
          current[key] = Number((min + Math.round(Math.random() * steps) * step).toFixed(6))
        }
        writeBack()
      })

      /*
       * Only what differs from the default. The whole point is to paste the
       * result into your own code, and forty lines of values you never touched
       * is not a thing anybody wants to read back.
       */
      controls.querySelector('[data-controls-copy]')?.addEventListener('click', async event => {
        const button = event.currentTarget as HTMLButtonElement
        const changed = Object.entries(current).filter(
          ([key, value]) => String(value) !== String(schema[key]?.default)
        )
        const lines = changed.map(
          ([k, v]) => '  ' + k + ': ' + (typeof v === 'string' ? "'" + v + "'" : v)
        )
        const body = changed.length ? ', {\n' + lines.join(',\n') + '\n}' : ''
        const factory = button.dataset['factory'] ?? 'createEffect'
        const text = factory + '(el' + body + ')'
        try {
          await navigator.clipboard.writeText(text)
          button.textContent = changed.length ? 'Copied ' + changed.length : 'Copied defaults'
        } catch {
          button.textContent = 'Press ctrl C'
        }
        setTimeout(() => (button.textContent = 'Copy options'), 1600)
      })
    }
  }
</script>
