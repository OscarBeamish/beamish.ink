---
/*
 * A grid's page: the real demo at the top, in a frame, then the reference.
 *
 * WHY A FRAME AND NOT MARKUP ON THIS PAGE
 *
 * A grid is a whole page's worth of layout. It sets custom properties on
 * :root, it lays out full-bleed bands, and the thing worth looking at is how
 * those behave down a long page at a real width. Rendered inside this document
 * it is none of those things: the bands are bounded by the site's own column,
 * the :root properties land on a document the site also styles, and what you
 * read is a demonstration of the grid inside another grid.
 *
 * The version before this one did render it inline, and it worked, but it cost
 * more than it looked like. Each of the seven grids needed its own composition
 * written in its own class names, in this file, because a single composition
 * written in TwelveColumn's names rendered as unstyled blocks on the other six.
 * That is seven hand-written layouts kept in step with seven demo pages that
 * already existed and already said the same thing, in a file that is otherwise
 * about reference material. The frame deletes all of it and shows the real
 * page instead of a shortened restatement of it.
 *
 * It also puts the grid overlay back where it belongs. Three of these grids
 * draw their rules over the layout and four have nothing to draw, and each of
 * those three already carries its own floating toggle inside its demo. This
 * page used to carry a second copy of that button and a second copy of the
 * overlay markup, for the same three grids, to drive the inline composition.
 *
 * The standalone demo is a link as well as a frame. Scrolling a long document
 * inside a frame is workable and not pleasant, particularly on a phone, so the
 * way out is directly underneath it rather than at the bottom of the page.
 */
import Base from '../../layouts/Base.astro'
import { loadGrids, loadGridSource, GRID_CATEGORY_LABELS } from '../../lib/grids'
import { loadPrompts } from '../../lib/catalogue'
import PromptButtons from '../../components/PromptButtons.astro'

export function getStaticPaths() {
  return loadGrids().map(grid => ({ params: { slug: grid.slug }, props: { grid } }))
}

const { grid } = Astro.props
const source = loadGridSource(grid.slug)
/*
 * demo.html rather than the directory. Measured: `astro dev` returns 404 for
 * `/grid-demos/<slug>/`, because its static middleware does not resolve a
 * directory to its index, while the built site serves it happily. Both serve
 * this one.
 */
const demo = `/grid-demos/${grid.slug}/demo.html`
const properties = Object.entries(grid.properties)
/*
 * The same two prompts every other item has, generated the same way and
 * pinned to the same tag. A grid is pasted like everything else here.
 */
const { linked, inlined } = loadPrompts(grid.slug)

/*
 * Which grids draw their rules, so the line under the frame tells you the
 * toggle is there only where there is one. The three that do are the three
 * whose structure is invisible without it; FullBleedTiles, MarginaliaColumns,
 * OverlapGrid and MasonryColumns show their structure by existing.
 */
const DRAWS_RULES = new Set(['twelve-column', 'baseline-grid', 'asymmetric-columns'])
const hasToggle = DRAWS_RULES.has(grid.slug)
---

<Base title={`${grid.name}: Beamish`} description={grid.description}>
  <section class="spine pt-32 pb-8 md:pt-40">
    <h1 class="col-span-12 text-[clamp(2.2rem,6vw,4.5rem)] leading-[0.95] lg:col-span-9">
      {grid.name}
    </h1>
    <p
      class="text-l2 col-span-12 mt-6 font-mono text-[0.9rem] leading-[1.7] sm:col-span-9 lg:col-span-6"
    >
      {grid.description}. {GRID_CATEGORY_LABELS[grid.category]}, and the page in
      the frame below is built with it.
    </p>
  </section>

  {/*
    The page using the grid, in its own document.

    The height is viewport-relative with a ceiling: a layout is read by going
    down it, so a short frame defeats the point, and a frame taller than about
    forty-eight rems on a tall monitor is showing more of the demo than of this
    page. No background colour is set, because the demos carry a ground and
    hard-coding one here would flash the wrong colour before the frame paints.

    Shorter than the viewport on a phone, and that is the whole reason for the
    breakpoint. At 78vh the frame measured 658px inside an 844px window and ran
    155px past the fold, so once you had scrolled to it there was no page left
    beside it to put a thumb on: every touch went to the document inside the
    frame and the page underneath could not be moved. 60vh leaves about a third
    of the window outside it at all times.

    Not `loading="lazy"`. This is the first thing on the page and above the
    fold on every width, so deferring it only means arriving at a blank box.
  */}
  <section class="spine pb-4">
    <div class="border-line col-span-12 overflow-hidden rounded-[2px] border">
      <iframe
        src={demo}
        title={`${grid.name} in use`}
        class="block h-[60vh] w-full border-0 md:h-[min(78vh,48rem)]"></iframe>
    </div>
  </section>

  <section class="spine pb-16">
    <p class="text-l3 col-span-12 font-mono text-[0.72rem] leading-[1.7]">
      Scroll inside the frame.{
        hasToggle && ' Press Show grid, bottom right, to see the rules.'
      }{' '}
      <a href={demo} target="_blank" rel="noreferrer" class="underline"
        >Open it on its own</a
      > for the full width.
    </p>
  </section>

  <section class="spine pb-12">
    <h2 class="col-span-12 text-[1.6rem] leading-tight">The properties are the interface</h2>
    <p class="text-l2 col-span-12 mt-3 font-mono text-[0.8rem] leading-[1.7] lg:col-span-7">
      Override these in your own stylesheet rather than editing the file, so the
      next version is a clean replacement.
    </p>
    <dl class="col-span-12 mt-8 grid grid-cols-1 gap-x-8 gap-y-6 lg:grid-cols-2">
      {
        properties.map(([name, spec]) => (
          <div class="border-line border-t pt-3">
            <dt class="flex flex-wrap items-baseline justify-between gap-2">
              <code class="font-mono text-[0.78rem]">{name}</code>
              <code class="text-l3 font-mono text-[0.68rem]">{spec.default}</code>
            </dt>
            <dd class="text-l2 mt-2 ml-0 font-mono text-[0.74rem] leading-[1.65]">
              {spec.description}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    grid.notes.length > 0 && (
      <section class="spine pb-12">
        <h2 class="col-span-12 text-[1.6rem] leading-tight">What it gets right</h2>
        <ul class="col-span-12 mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">
          {grid.notes.map(note => (
            <li class="text-l2 border-line border-t pt-3 font-mono text-[0.74rem] leading-[1.65]">
              {note}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="spine pb-32">
    <h2 class="col-span-12 text-[1.6rem] leading-tight">The stylesheet</h2>
    <p class="text-l2 col-span-12 mt-3 font-mono text-[0.8rem] leading-[1.7] lg:col-span-7">
      This is the whole item. Copy it into your project, link it, and use the
      class names. Nothing to install and nothing to mount.
    </p>
    <div class="col-span-12 mt-6">
      <PromptButtons slug={grid.slug} linked={linked} inlined={inlined} />
    </div>
    <pre
      class="border-line bg-be text-l1 col-span-12 mt-6 max-h-[32rem] overflow-auto rounded-[2px] border p-4 font-mono text-[0.72rem] leading-[1.6]"
    ><code>{source}</code></pre>
  </section>
</Base>
