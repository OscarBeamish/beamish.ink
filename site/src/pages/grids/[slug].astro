---
/*
 * A grid's page.
 *
 * The demo is an iframe rather than markup rebuilt in Astro, and that is the
 * whole design of this page. The demo sets custom properties on :root and lays
 * out full-bleed bands; rendered inside this document those would fight the
 * site's own styles, and what the reader saw would not be what the stylesheet
 * actually does. An iframe is its own document, so the grid is shown doing
 * exactly what it will do in your project.
 */
import Base from '../../layouts/Base.astro'
import { loadGrids, loadGridSource, GRID_CATEGORY_LABELS } from '../../lib/grids'

export function getStaticPaths() {
  return loadGrids().map(grid => ({ params: { slug: grid.slug }, props: { grid } }))
}

const { grid } = Astro.props
const source = loadGridSource(grid.slug)
// A directory URL: Astro redirects `/x.html` to `/x`, which would 404.
const demo = `/grid-demos/${grid.slug}/`
const properties = Object.entries(grid.properties)
---

<Base title={`${grid.name}: Beamish`} description={grid.description}>
  <section class="spine pt-32 pb-10 md:pt-40">
    <p class="text-l3 col-span-12 font-mono text-[0.68rem] tracking-[0.16em] uppercase">
      {GRID_CATEGORY_LABELS[grid.category]}, a grid system
    </p>
    <h1 class="col-span-12 mt-4 text-[clamp(2.2rem,6vw,4.5rem)] leading-[0.95] lg:col-span-9">
      {grid.name}
    </h1>
    <p class="text-l2 col-span-12 mt-6 font-mono text-[0.9rem] leading-[1.7] sm:col-span-9 lg:col-span-6">
      {grid.description}.
    </p>
  </section>

  {/*
    The page using the grid. Tall, because a layout is read by going down it,
    and scrollable inside its own frame.
  */}
  <section class="spine pb-6">
    <div class="border-line col-span-12 overflow-hidden rounded-[2px] border">
      <iframe
        src={demo}
        title={`${grid.name} in use`}
        loading="lazy"
        class="block h-[80vh] w-full border-0 bg-white"
      ></iframe>
    </div>
    <p class="text-l3 col-span-12 mt-3 font-mono text-[0.68rem]">
      Scroll inside the frame. Press Show grid to see the columns.
      <a href={demo} target="_blank" rel="noreferrer" class="underline">
        Open it on its own
      </a>
      .
    </p>
  </section>

  <section class="spine py-16">
    <h2 class="col-span-12 text-[1.6rem] leading-tight">The properties are the interface</h2>
    <p class="text-l2 col-span-12 mt-3 font-mono text-[0.8rem] leading-[1.7] lg:col-span-7">
      Override these in your own stylesheet rather than editing the file, so the
      next version is a clean replacement.
    </p>
    <dl class="col-span-12 mt-8 grid grid-cols-1 gap-x-8 gap-y-6 lg:grid-cols-2">
      {
        properties.map(([name, spec]) => (
          <div class="border-line border-t pt-3">
            <dt class="flex flex-wrap items-baseline justify-between gap-2">
              <code class="font-mono text-[0.78rem]">{name}</code>
              <code class="text-l3 font-mono text-[0.68rem]">{spec.default}</code>
            </dt>
            <dd class="text-l2 mt-2 ml-0 font-mono text-[0.74rem] leading-[1.65]">
              {spec.description}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {grid.notes.length > 0 && (
    <section class="spine pb-16">
      <h2 class="col-span-12 text-[1.6rem] leading-tight">What it gets right</h2>
      <ul class="col-span-12 mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">
        {grid.notes.map(note => (
          <li class="text-l2 border-line border-t pt-3 font-mono text-[0.74rem] leading-[1.65]">
            {note}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="spine pb-32">
    <h2 class="col-span-12 text-[1.6rem] leading-tight">The stylesheet</h2>
    <p class="text-l2 col-span-12 mt-3 font-mono text-[0.8rem] leading-[1.7] lg:col-span-7">
      This is the whole item. Copy it into your project, link it, and use the
      class names.
    </p>
    <div class="col-span-12 mt-6">
      <button
        type="button"
        class="beamish-sheen-button beamish-sheen-button--quiet"
        data-copy-grid
      >
        Copy stylesheet
      </button>
    </div>
    <pre
      class="border-line bg-be text-l1 col-span-12 mt-6 max-h-[32rem] overflow-auto rounded-[2px] border p-4 font-mono text-[0.72rem] leading-[1.6]"
      data-grid-source><code>{source}</code></pre>
  </section>
</Base>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-grid]')
  const source = document.querySelector<HTMLElement>('[data-grid-source]')
  button?.addEventListener('click', async () => {
    if (!source?.textContent) return
    await navigator.clipboard.writeText(source.textContent)
    const was = button.textContent
    button.textContent = 'Copied'
    setTimeout(() => {
      button.textContent = was
    }, 1600)
  })
</script>
