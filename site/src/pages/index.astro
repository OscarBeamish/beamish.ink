---
/*
 * The front door.
 *
 * It used to be the effects catalogue itself: hero, then sixty-one cards under
 * six category headings. That was right while effects were all there was. With
 * nineteen templates and eight grids beside them it stopped being right, for a
 * reason worth writing down: a homepage that is one tier's index tells the
 * reader the other tiers are afterthoughts, whatever the nav says. The wall
 * moved to /effects unchanged and this page became three shelves.
 *
 * Effects first, then grids, then templates. The shelves used to lead with
 * templates, on the reasoning that a template is a page and everybody already
 * knows what a page is, so it is the one tier that explains itself. That is
 * true and it was still the wrong lead: the effects are the bulk of the
 * library and the thing anybody arrives here for, and a front door that opens
 * on the smallest tier buries them.
 *
 * The order it leaves is also the order of assembly, which is a better story
 * than the old one: a piece, then the rules a page is laid out on, then a
 * whole page with both in it.
 *
 * The three on each shelf are chosen by hand and listed here rather than taken
 * off the front of the catalogue. Alphabetical order is not a curation, and a
 * shelf is the one place on the site where the point is to show the range
 * rather than the inventory. They are picked to disagree with each other: a
 * dark instrument beside pale editorial type, a shader beside a text effect.
 */
import Base from '../layouts/Base.astro'
import ItemCard from '../components/ItemCard.astro'
import { loadCatalogue, loadMedia } from '../lib/catalogue'
import { loadGrids, loadGridMedia, GRID_CATEGORY_LABELS } from '../lib/grids'
import { loadTemplates, loadTemplateMedia } from '../lib/templates'
import { CATEGORY_LABELS } from '../../../tools/schema/meta'

const items = loadCatalogue()
const grids = loadGrids()
const templates = loadTemplates()

/*
 * The front of the templates wall, not a second pick.
 *
 * This used to name three slugs itself, for variety: a dark machine, a page
 * made of type and a soft product interface. That was a judgement about which
 * templates matter most, and the wall now carries the same judgement in
 * WALL_FRONT, so keeping both meant the front door and the wall could disagree
 * about which template to meet first. They did.
 */
const SHOWN_TEMPLATES = templates.slice(0, 3).map(template => template.slug)
/*
 * The front of the effects wall, for the same reason as the templates above.
 *
 * This named three slugs of its own, one of each kind: a three.js scene, a
 * shader backdrop and a text effect. That was a reasonable pick and it is a
 * second opinion about a question the wall now answers, so it goes.
 *
 * The consequence is worth saying out loud rather than discovering: the top
 * of the effects wall is five backdrops, so the front door now shows three
 * backdrops instead of one of each kind. The shelf is more coherent and less
 * representative. If that is the wrong trade, the fix is to change the order
 * of the wall rather than to pick again here.
 */
const SHOWN_ITEMS = items.slice(0, 3).map(item => item.slug)
/* The plainest, the strictest and the one that is obviously a layout. */
const SHOWN_GRIDS = ['twelve-column', 'baseline-grid', 'marginalia-columns']

/*
 * Picked in the order written above rather than in catalogue order, and a slug
 * that no longer exists is dropped rather than rendered as a hole. The counts
 * under each heading come from the real collections, so a shelf can go stale
 * without the number beside it lying.
 */
const shelves = [
  {
    heading: 'Effects and components',
    blurb: 'Scenes, shaders, text and interface parts',
    href: '/effects',
    total: items.length,
    cards: SHOWN_ITEMS.map(slug => items.find(i => i.slug === slug))
      .filter(i => i !== undefined)
      .map(item => ({
        href: `/${item.group}/${item.slug}`,
        name: item.name,
        description: item.description,
        label: CATEGORY_LABELS[item.category],
        media: loadMedia(item)
      }))
  },
  {
    heading: 'Grids',
    blurb: 'Editorial layout as plain CSS',
    href: '/grids',
    total: grids.length,
    cards: SHOWN_GRIDS.map(slug => grids.find(g => g.slug === slug))
      .filter(g => g !== undefined)
      .map(grid => ({
        href: `/grids/${grid.slug}`,
        name: grid.name,
        description: grid.description,
        label: GRID_CATEGORY_LABELS[grid.category],
        media: loadGridMedia(grid.slug)
      }))
  },
  {
    heading: 'Templates',
    blurb: 'Whole pages, one file each',
    href: '/templates',
    total: templates.length,
    cards: SHOWN_TEMPLATES.map(slug => templates.find(t => t.slug === slug))
      .filter(t => t !== undefined)
      .map(template => ({
        href: `/templates/${template.slug}`,
        name: template.name,
        description: template.description,
        label: template.ground === 'dark' ? 'Dark' : 'Light',
        media: loadTemplateMedia(template.slug)
      }))
  }
]

const total = items.length + grids.length + templates.length
---

<Base
  title="Beamish: web effects, templates and grids for AI agents"
  description="Whole pages, three.js scenes, WebGL shaders and interface components. Nothing to install: copy a prompt, paste it into your AI agent, and it writes the code."
>
  <section class="spine pt-32 pb-16 md:pt-44">
    {/*
      A trial of the statement register, after haoqi.design, whose toggle and
      label tokens this site already took.

      Three things make it that register rather than a bigger version of what
      was here. The line is uppercase with leading-none, so the lockup is a
      block of letterforms rather than a sentence that happens to be large. It
      is sized in svw rather than clamped against rem, so it holds its share of
      the viewport instead of stopping at a ceiling. And each line sits in its
      own columns of the page grid, stepping right, so the shape is placed
      rather than flowed: the thing that makes their pages read as composed is
      that the words are put somewhere, not that the type is big.

      What is missing is the width axis. Theirs pushes the variable face to
      wdth 120, and the Archivo subset bundled here is weight-only, 400 to 700,
      so that part waits on a font file with the axis in it.

      Each line is still a whole phrase, which is the one thing worth keeping
      from the lockup this replaces: left to wrap on its own, the break landed
      after a preposition at every width tested.
    */}
    <h1
      class="col-span-12 grid grid-cols-12 gap-x-2 text-[10.5svw] leading-[0.86] font-bold tracking-[-0.012em] uppercase lg:text-[6.6svw]"
    >
      <span class="col-span-12">Pages, effects</span>
      {/* The stepping is a composition for a wide screen. On a phone the
          columns are narrow enough that an indented line wraps, which turns
          three placed lines into four flowed ones, so below lg each takes the
          full width. */}
      <span class="text-l3 col-span-12 lg:col-span-11 lg:col-start-2">and grids</span>
      <span class="col-span-12 lg:col-span-9 lg:col-start-4">for AI agents</span>
    </h1>
    <p class="text-l2 col-span-12 mt-10 text-[1rem] sm:col-span-9 lg:col-span-6 lg:col-start-4">
      Whole pages you can take as one file, three.js scenes, WebGL shaders, text
      animations, interface components and the grids underneath them. There is
      nothing to install. Pick one, press Copy prompt, and paste it into Claude
      Code or Cursor. Your agent fetches the source and writes it into your
      project.
    </p>

    <ol class="text-l2 col-span-12 mt-10 grid gap-3 text-[0.9rem] sm:col-span-9 lg:col-span-5">
      <li class="border-line flex gap-4 border-t pt-3">
        <span class="tag flex-none pt-[0.15rem]">01</span>
        <span>Pick one and watch it run.</span>
      </li>
      <li class="border-line flex gap-4 border-t pt-3">
        <span class="tag flex-none pt-[0.15rem]">02</span>
        <span>Press <span class="text-l1">Copy prompt</span>.</span>
      </li>
      <li class="border-line flex gap-4 border-t pt-3">
        <span class="tag flex-none pt-[0.15rem]">03</span>
        <span>Paste it into your agent. It handles the rest.</span>
      </li>
    </ol>

    <p class="tag col-span-12 mt-10">
      {total} items · MIT · works with Claude Code, Cursor, Copilot, Windsurf
    </p>
  </section>

  {/*
    The shelves. Same card and same three columns as every wall on the site, so
    a shelf reads as the top of a wall rather than as a different component,
    and the link at the right of each heading is the rest of it.

    id="catalogue" is on the first shelf because the nav and some item pages
    have linked to /#catalogue since the first version of the site. The anchor
    now lands on the shelves rather than on the wall, which is the correct
    destination for it: the wall has its own URL.
  */}
  <section id="catalogue" class="spine gap-x-[0.35rem] gap-y-[0.35rem] pb-24">
    {
      shelves.map((shelf, index) => (
        <Fragment>
          <div
            class:list={[
              'border-line col-span-12 mb-2 flex scroll-mt-24 items-baseline justify-between gap-6 border-b pb-3',
              index > 0 && 'mt-14'
            ]}
          >
            <h2 class="text-[1.05rem]">{shelf.heading}</h2>
            <p class="tag hidden text-right sm:block">{shelf.blurb}</p>
            <a href={shelf.href} class="tag text-l1 flex-none whitespace-nowrap hover:underline">
              All {shelf.total} &#8594;
            </a>
          </div>
          {shelf.cards.map(card => (
            <div class="col-span-12 sm:col-span-6 lg:col-span-4">
              <ItemCard
                href={card.href}
                name={card.name}
                description={card.description}
                label={card.label}
                media={card.media}
              />
            </div>
          ))}
        </Fragment>
      ))
    }
  </section>
</Base>
