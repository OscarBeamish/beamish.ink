---
/*
 * A hidden page showing somebody else's work.
 *
 * Playable Worlds is by lovis odin: twenty-six generated videos rebuilt as
 * playable WebGL games by Claude and the fal Agent SDK. It is mirrored here so
 * it can be shown without a network, and it is not ours. The credit is in the
 * markup rather than in a comment, the page is noindex, and it is linked from
 * nowhere.
 *
 * The mirror itself lives in public/playable-worlds and is gitignored: 713MB
 * of models, textures and audio, against a repo whose own video budget is
 * three and a half. `tools/playable-worlds/mirror.py` rebuilds it.
 */
import fs from 'node:fs'
import path from 'node:path'
import Base from '../layouts/Base.astro'

type Game = {
  tag: string
  model: string
  prompt: string
  controls: string
  usd?: number
  images?: string[]
  audios?: string[]
  glbs?: { f: string; mb: number }[]
  models?: { id: string; n: number }[]
}

const MIRROR = path.join(process.cwd(), 'public', 'playable-worlds')
const manifest = path.join(MIRROR, 'games.json')

/*
 * The mirror is not in git, so a fresh clone has no games.json. The page says
 * so rather than failing the build: a missing 700MB download is a thing to go
 * and fetch, not a broken site.
 */
const present = fs.existsSync(manifest)
const games: Game[] = present ? JSON.parse(fs.readFileSync(manifest, 'utf8')) : []

const title = (tag: string) =>
  tag
    .replace(/^[A-Z]+\d+_/, '')
    .replace(/_.*$/, '')
    .toLowerCase()
    .split('-')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ')

/* Every distinct fal endpoint across the set, commonest first. */
const endpoints = new Map<string, number>()
for (const g of games) {
  for (const m of g.models ?? []) endpoints.set(m.id, (endpoints.get(m.id) ?? 0) + m.n)
}
const byUse = [...endpoints.entries()].sort((a, b) => b[1] - a[1])
---

<Base
  title="Playable Worlds: a mirror"
  description="Twenty-six generated videos rebuilt as playable WebGL games, by lovis odin. Mirrored here to run without a network."
  noindex={true}
>
  <article class="spine pt-32 pb-16 md:pt-44">
    <h1
      class="col-span-12 mt-3 text-[10.5svw] leading-[0.86] font-bold tracking-[-0.012em] uppercase lg:col-span-8 lg:text-[6.6svw]"
    >
      Playable Worlds
    </h1>

    <p class="text-l2 col-span-12 mt-6 text-[1rem] sm:col-span-9 lg:col-span-6">
      Twenty-six generated videos, each watched by Claude and rebuilt as a playable
      WebGL game. Every texture, model and track generated too. This is
      <strong>somebody else&rsquo;s work</strong>, kept here so it can be shown
      without a network.
    </p>

    <dl class="subgrid-12 col-span-12 mt-10 gap-y-4">
      <div class="col-span-6 sm:col-span-3">
        <dt class="tag">Made by</dt>
        <dd class="mt-1 text-[0.95rem]">lovis odin</dd>
      </div>
      <div class="col-span-6 sm:col-span-3">
        <dt class="tag">Built with</dt>
        <dd class="mt-1 text-[0.95rem]">Claude + fal Agent SDK</dd>
      </div>
      <div class="col-span-6 sm:col-span-3">
        <dt class="tag">Original</dt>
        <dd class="mt-1 text-[0.95rem]">
          <a
            class="underline underline-offset-4"
            href="https://fal-video-to-game.vercel.app"
            rel="noopener noreferrer"
            target="_blank">fal-video-to-game.vercel.app</a
          >
        </dd>
      </div>
      <div class="col-span-6 sm:col-span-3">
        <dt class="tag">Engine</dt>
        <dd class="mt-1 text-[0.95rem]">three.js only, no framework</dd>
      </div>
    </dl>

    {
      !present && (
        <div class="col-span-12 mt-10 border border-line p-6 sm:col-span-9">
          <p class="text-[0.95rem]">The mirror is not on this machine.</p>
          <p class="text-l2 mt-2 text-[0.9rem]">
            It is 713MB and deliberately not in git. Run{' '}
            <code>python tools/playable-worlds/mirror.py</code> to fetch it into{' '}
            <code>site/public/playable-worlds/</code>, then reload.
          </p>
        </div>
      )
    }

    {
      byUse.length > 0 && (
        <ul class="col-span-12 mt-8 flex flex-wrap gap-x-3 gap-y-2 lg:col-span-9">
          {byUse.map(([id, n]) => (
            <li class="tag">
              {id} <span class="text-l3">&times;{n}</span>
            </li>
          ))}
        </ul>
      )
    }

    <ol class="subgrid-12 col-span-12 mt-16 gap-y-16">
      {
        games.map((g, i) => (
          <li class="subgrid-12 col-span-12">
            <p class="tag col-span-12 sm:col-span-3">
              {String(i + 1).padStart(2, '0')}
            </p>

            <div class="col-span-12 sm:col-span-9 sm:col-start-4">
              <h2 class="text-[1.4rem] leading-tight font-semibold tracking-[-0.01em]">
                {title(g.tag)}
              </h2>
              <p class="tag mt-1">{g.model}</p>

              <div class="mt-4 grid gap-4 md:grid-cols-2">
                {/*
                  The source clip and the thing it became, side by side. That
                  pairing is the whole argument of the original and it is the
                  reason to show them together rather than linking out.
                */}
                <figure class="m-0">
                  <video
                    class="aspect-video w-full rounded-[2px] border border-line bg-be object-cover"
                    src={`/playable-worlds/videos/${g.tag}.mp4`}
                    muted
                    loop
                    playsinline
                    preload="none"
                    controls
                  />
                  <figcaption class="tag mt-2">Video &middot; input</figcaption>
                </figure>

                {/*
                  The game starts as a button and becomes an iframe when you
                  press it, which is how the original does it and is the only
                  way it can work: twenty-six live frames would be twenty-six
                  WebGL contexts against a browser limit of about sixteen, and
                  seven hundred megabytes of loading nobody asked for. One at a
                  time, and the last one is torn down when the next starts.
                */}
                <figure class="m-0">
                  <div
                    class="relative aspect-video w-full overflow-hidden rounded-[2px] border border-line bg-be"
                    data-slot
                    data-game={`/playable-worlds/${g.tag}/index.html`}
                    data-name={title(g.tag)}
                  >
                    <button
                      class="absolute inset-0 flex cursor-pointer items-center justify-center gap-2 text-[0.8rem] tracking-[0.08em] uppercase"
                      type="button"
                      data-play
                    >
                      Play
                    </button>
                  </div>
                  <figcaption class="tag mt-2 flex items-center justify-between gap-3">
                    <span>WebGL game &middot; output</span>
                    <a
                      class="underline underline-offset-4"
                      href={`/playable-worlds/${g.tag}/index.html`}
                      target="_blank"
                      rel="noopener noreferrer">Full screen &nearr;</a
                    >
                  </figcaption>
                </figure>
              </div>

              <p class="text-l3 mt-4 text-[0.8rem]">{g.controls}</p>

              <p class="tag mt-3">
                {g.images?.length ?? 0} images &middot; {g.glbs?.length ?? 0} models
                &middot; {g.audios?.length ?? 0} audio
                {g.usd ? <> &middot; ${g.usd.toFixed(2)}</> : null}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </article>
</Base>

<script>
  /*
   * Two jobs: load the clips lazily, and keep exactly one game alive.
   */

  const reduced = matchMedia('(prefers-reduced-motion: reduce)')

  /*
   * The videos preload nothing, because twenty-six of them on one page is
   * twelve megabytes nobody asked for. They load as they come near and play
   * while they are on screen.
   */
  const started = new WeakSet<HTMLVideoElement>()
  const watcher = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement
        if (entry.isIntersecting) {
          if (!started.has(video)) {
            started.add(video)
            video.preload = 'metadata'
            video.load()
          }
          if (!reduced.matches) void video.play().catch(() => {})
        } else {
          video.pause()
        }
      }
    },
    { rootMargin: '200px 0px' }
  )
  for (const video of document.querySelectorAll('video')) watcher.observe(video)

  /*
   * One game at a time.
   *
   * Each slot is a button until it is pressed, then it becomes an iframe.
   * Starting another tears the last one down first, and the teardown points
   * the old frame at about:blank rather than just removing it: a dropped
   * iframe can keep its audio and its WebGL context for longer than you would
   * like, and the browser only allows about sixteen contexts before it starts
   * killing the oldest. Twenty-six live frames is not an option.
   */
  type Live = { slot: HTMLElement; frame: HTMLIFrameElement; button: HTMLButtonElement }
  let live: Live | null = null

  function stop() {
    if (!live) return
    live.frame.src = 'about:blank'
    live.frame.remove()
    live.slot.appendChild(live.button)
    live = null
  }

  function play(slot: HTMLElement, button: HTMLButtonElement) {
    stop()
    const src = slot.dataset.game
    if (!src) return
    const frame = document.createElement('iframe')
    frame.src = src
    frame.title = slot.dataset.name ?? 'Game'
    frame.className = 'absolute inset-0 h-full w-full border-0'
    /* Gamepad and fullscreen are the two the games actually ask for. */
    frame.allow = 'autoplay; fullscreen; gamepad; xr-spatial-tracking'
    button.remove()
    slot.appendChild(frame)
    live = { slot, frame, button }
    /* The games read the keyboard, so the frame has to have focus or the
       first arrow key scrolls the page instead of moving anything. */
    frame.addEventListener('load', () => frame.focus(), { once: true })
  }

  for (const slot of document.querySelectorAll<HTMLElement>('[data-slot]')) {
    const button = slot.querySelector<HTMLButtonElement>('[data-play]')
    if (!button) continue
    button.addEventListener('click', () => play(slot, button))
  }

  /* A game left running in a hidden tab keeps making noise and keeps its
     context. Stop it, and stop it on a client-side swap too. */
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop()
  })
  document.addEventListener('astro:before-swap', stop)
</script>
