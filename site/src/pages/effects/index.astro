---
/*
 * The effects and components wall.
 *
 * This is the page the homepage used to be. It moved when the library stopped
 * being one kind of thing: with nineteen templates and eight grids beside the
 * effects, a homepage that was itself the effects catalogue said the other two
 * tiers were footnotes, and the only way in to either was a nav link.
 *
 * The URL is /effects although four of the sixty-one are components, because
 * the wall is grouped by what a thing does rather than by which tier it is in,
 * and the nav has called this Effects since the first version of the site.
 * Components are a contract, not a category: that distinction matters when you
 * paste one and not when you are looking for something that follows a cursor.
 */
import Base from '../../layouts/Base.astro'
import ItemCard from '../../components/ItemCard.astro'
import { loadCatalogue, loadMedia, CATEGORY_ORDER } from '../../lib/catalogue'
import { CATEGORY_LABELS, CATEGORY_BLURBS } from '../../../../tools/schema/meta'

const items = loadCatalogue()

const groups = CATEGORY_ORDER.map(category => ({
  category,
  items: items.filter(item => item.category === category)
})).filter(group => group.items.length > 0)
---

<Base
  title="Beamish: effects and components"
  description="Three.js scenes, WebGL shaders, text animations and interface components. Nothing to install: copy a prompt, paste it into your AI agent, and it writes the code."
>
  <section class="spine pt-32 pb-16 md:pt-44">
    <h1 class="col-span-12 text-[clamp(2.3rem,7vw,5rem)] leading-[0.95] lg:col-span-10">
      <span class="block">Effects and components</span>
      <span class="text-l3 block">for AI agents.</span>
    </h1>
    <p class="text-l2 col-span-12 mt-8 text-[1rem] sm:col-span-9 lg:col-span-6">
      Three.js scenes, WebGL shaders, text animations and interface components.
      There is nothing to install. Pick one, press Copy prompt, and paste it into
      Claude Code or Cursor. Your agent fetches the source and writes it into your
      project.
    </p>

    <p class="tag col-span-12 mt-10">
      {items.length} items · MIT · works with Claude Code, Cursor, Copilot,
      Windsurf
    </p>
  </section>

  {/*
    The cards sit directly in the page grid rather than in a grid of their own
    inside each category. Nesting one meant a card's left edge was set by its
    group's width instead of by the page, so the columns drifted out of step
    with the heading above them at some widths. Fragment, so no wrapper element
    breaks the grid flow.
  */}
  <section id="catalogue" class="spine gap-y-5 pb-16">
    {
      groups.map((group, index) => (
        <Fragment>
          {/* The blurb is hidden below 640px. At 390px it collided with the
              heading, and it is a nicety rather than information. */}
          {/* An id, so an item page can link back to the shelf it came
              from. scroll-mt clears the fixed header, which otherwise lands
              the heading underneath it. */}
          <div
            id={group.category}
            class:list={[
              'border-line col-span-12 flex scroll-mt-24 items-baseline justify-between gap-6 border-b pb-3',
              index > 0 && 'mt-11'
            ]}
          >
            <h2 class="text-[1.05rem]">{CATEGORY_LABELS[group.category]}</h2>
            <p class="tag hidden text-right sm:block">{CATEGORY_BLURBS[group.category]}</p>
          </div>
          {group.items.map(item => (
            <div class="col-span-12 sm:col-span-6 lg:col-span-4">
              <ItemCard
                href={`/${item.group}/${item.slug}`}
                name={item.name}
                description={item.description}
                label={CATEGORY_LABELS[item.category]}
                media={loadMedia(item)}
              />
            </div>
          ))}
        </Fragment>
      ))
    }
  </section>
</Base>
