---
/*
 * The templates wall.
 *
 * Each card opens a standalone page rather than a page inside this site, and
 * that is deliberate: a template is supposed to read as somebody's own site,
 * which it cannot do wearing this one's header. The card is the only place
 * the library speaks about it.
 *
 * Which is why the prompt sits on the card rather than behind a detail page.
 * A template is for taking, and a wall of previews with no way to take one
 * from it would make the reader click through to a page that says nothing
 * about the library just to come back.
 */
import Base from '../../layouts/Base.astro'
import ItemCard from '../../components/ItemCard.astro'
import PromptButtons from '../../components/PromptButtons.astro'
import { loadTemplates, loadTemplateMedia, loadTemplatePrompt } from '../../lib/templates'

const templates = loadTemplates().map(template => ({
  template,
  media: loadTemplateMedia(template.slug),
  prompt: loadTemplatePrompt(template.slug)
}))
---

<Base
  title="Beamish: templates"
  description="Whole pages, each one a single file you can take. Most are adapted from the instalanding.ai library under its MIT licence, and each says whose work it was."
>
  <section class="spine pt-32 pb-16 md:pt-44">
    <h1 class="col-span-12 text-[clamp(2.3rem,7vw,5rem)] leading-[0.95] lg:col-span-10">
      <span class="block">Whole pages,</span>
      <span class="text-l3 block">one file each.</span>
    </h1>
    <p class="text-l2 col-span-12 mt-8 text-[1rem] sm:col-span-9 lg:col-span-6">
      Everything one of these needs is in its own index.html: its CSS, its SVG
      and its script. Every brand on them is invented and every figure is made up, so there is nothing to unpick
      before you start. Most of these are adapted from somebody else's work
      under its licence, and each one says whose, on its own page and in its
      prompt.
    </p>
  </section>

  <section class="spine pb-32">
    <ul class="col-span-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        templates.map(({ template, media, prompt }) => (
          <li class="flex h-full flex-col gap-4">
            <ItemCard
              href={`/templates/${template.slug}/index.html`}
              name={template.name}
              description={template.description}
              label={template.ground === 'dark' ? 'Dark' : 'Paper'}
              media={media}
            />
            <PromptButtons slug={template.slug} linked={prompt} />
          </li>
        ))
      }
      {
        templates.length === 0 && (
          <li class="text-l3 col-span-full font-mono text-[0.8rem]">
            None yet.
          </li>
        )
      }
    </ul>
  </section>
</Base>
