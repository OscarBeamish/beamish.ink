---
/*
 * The templates wall.
 *
 * Same cards and same three columns as the effects and grids walls. A template
 * is a different kind of thing from an effect, but a wall of them is not a
 * different kind of wall, and the two that were two-up read as a separate site
 * sitting inside this one.
 *
 * The card opens the template's page here rather than the standalone file.
 * That page carries the frame, the licence it arrived under and the prompt,
 * which is everything the library has to say about it; the earlier version put
 * the prompt on the card and linked the card straight out, so the only place
 * the library spoke was the one surface the reader left immediately.
 */
import Base from '../../layouts/Base.astro'
import ItemCard from '../../components/ItemCard.astro'
import { loadTemplates, loadTemplateMedia } from '../../lib/templates'

const templates = loadTemplates().map(template => ({
  template,
  media: loadTemplateMedia(template.slug)
}))
---

<Base
  title="Beamish: templates"
  description="Whole pages, each one a single file you can take. Most are adapted from the instalanding.ai library under its MIT licence, and each says whose work it was."
>
  <section class="spine pt-32 pb-16 md:pt-44">
    <h1 class="col-span-12 text-[clamp(2.3rem,7vw,5rem)] leading-[0.95] lg:col-span-10">
      <span class="block">Whole pages,</span>
      <span class="text-l3 block">one file each.</span>
    </h1>
    <p class="text-l2 col-span-12 mt-8 text-[1rem] sm:col-span-9 lg:col-span-6">
      Everything one of these needs is in its own index.html: its CSS, its SVG
      and its script. Every brand on them is invented and every figure is made
      up, so there is nothing to unpick before you start. Most of these are
      adapted from somebody else's work under its licence, and each one says
      whose, on its own page and in its prompt.
    </p>
  </section>

  <section class="spine pb-32">
    <ul class="col-span-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        templates.map(({ template, media }) => (
          <li class="h-full">
            <ItemCard
              href={`/templates/${template.slug}`}
              name={template.name}
              description={template.description}
              label={template.ground === 'dark' ? 'Dark' : 'Light'}
              media={media}
            />
          </li>
        ))
      }
      {
        templates.length === 0 && (
          <li class="text-l3 col-span-full font-mono text-[0.8rem]">
            None yet.
          </li>
        )
      }
    </ul>
  </section>
</Base>
