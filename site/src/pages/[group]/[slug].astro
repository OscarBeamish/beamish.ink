---
import Base from '../../layouts/Base.astro'
import DemoPanel from '../../components/DemoPanel.astro'
import PromptButtons from '../../components/PromptButtons.astro'
import { loadCatalogue, loadMedia, loadPrompts, PIN } from '../../lib/catalogue'
import { CATEGORY_LABELS } from '../../../../tools/schema/meta'

export function getStaticPaths() {
  return loadCatalogue().map(item => ({
    params: { group: item.group, slug: item.slug },
    props: { item }
  }))
}

const { item } = Astro.props
const { linked, inlined } = loadPrompts(item.slug)
const media = loadMedia(item)

const options = Object.entries(item.options)

const range = (spec: (typeof options)[number][1]) => {
  if (spec.type === 'number') {
    const base = `${spec.min} to ${spec.max}${spec.unit ? ` ${spec.unit}` : ''}`
    return spec.sensible ? `${base}, good: ${spec.sensible[0]} to ${spec.sensible[1]}` : base
  }
  if (spec.type === 'enum') return (spec.values ?? []).join(' · ')
  if (spec.type === 'boolean') return 'true · false'
  if (spec.type === 'color') return 'css colour'
  return ''
}

const deps = Object.entries(item.peerDependencies)
const notes = [...item.browser.notes, ...item.perf.notes]
---

<Base
  title={`${item.name}: Beamish`}
  description={item.description}
  image={media.poster}
  video={media.mp4}
>
  {/*
    A reading column, with the demo breaking out of it. Everything that is words
    sits at a comfortable measure like a blog post; only the thing you are meant
    to look at goes wide.
  */}
  <article class="item pt-32 pb-8 md:pt-40">
    <header>
      <p class="tag">
        {CATEGORY_LABELS[item.category]} · {item.tier === 1 ? 'effect' : 'component'}
      </p>
      <h1 class="mt-3 text-[clamp(2.2rem,6vw,3.8rem)] leading-[0.95]">{item.name}</h1>
      <p class="text-l2 mt-5 text-[1rem]">{item.description}.</p>
    </header>

    <div class="item__wide mt-10">
      <DemoPanel
        slug={item.slug}
        tier={item.tier}
        instruction={item.instruction}
        oneShot={item.oneShot}
      />
    </div>

    <div class="mt-10">
      <PromptButtons slug={item.slug} linked={linked} inlined={inlined} />
    </div>

    <section class="mt-20">
      <h2 class="border-line border-b pb-3 text-[1.05rem]">Options</h2>
      {/*
        A list, not a table. Three columns of prose at this measure gives you a
        two-word column and a paragraph squeezed into 20ch.
      */}
      <dl class="mt-2">
        {
          options.map(([name, spec]) => (
            <div class="border-line border-b py-4">
              <dt class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <code class="text-l1 text-[0.85rem]">{name}</code>
                <span class="tag">
                  {String(spec.default) === '' ? 'empty' : String(spec.default)}
                </span>
              </dt>
              <dd class="mt-2 ml-0">
                {range(spec) && <p class="text-l3 text-[0.75rem]">{range(spec)}</p>}
                <p class="text-l2 mt-1 text-[0.85rem]">{spec.description}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-16">
      <h2 class="border-line border-b pb-3 text-[1.05rem]">What it needs</h2>
      <dl class="mt-4 grid gap-4 text-[0.85rem] sm:grid-cols-2">
        <div>
          <dt class="tag">Dependencies</dt>
          <dd class="text-l2 mt-1 ml-0">
            {deps.length === 0 ? 'None at all' : deps.map(([n, v]) => `${n}@${v}`).join(', ')}
          </dd>
        </div>
        <div>
          <dt class="tag">Browser</dt>
          <dd class="text-l2 mt-1 ml-0">
            {item.browser.webgl === 'none' ? 'No WebGL' : item.browser.webgl.toUpperCase()}
          </dd>
        </div>
        <div>
          <dt class="tag">Frame budget</dt>
          <dd class="text-l2 mt-1 ml-0">
            ~{item.perf.frameBudgetMs} ms · {item.perf.contexts} context
          </dd>
        </div>
        <div>
          <dt class="tag">Pinned to</dt>
          <dd class="text-l2 mt-1 ml-0">{PIN}</dd>
        </div>
      </dl>

      <ul class="text-l2 mt-8 grid gap-2 text-[0.85rem]">
        {notes.map(note => <li class="border-line border-t pt-2">{note}</li>)}
      </ul>

      {
        item.credit && (
          <p class="text-l3 mt-8 text-[0.8rem]">
            Concept credit: {item.credit.what}, by{' '}
            <a href={item.credit.url}>{item.credit.author}</a>. The implementation here is
            written from scratch.
          </p>
        )
      }
    </section>
  </article>
</Base>
